{
  "name": "trioditis",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "docs:dev": "pnpm --filter @trioditis/docs dev",
    "docs:build": "pnpm --filter @trioditis/docs build",
    "preview": "node scripts/preview.mjs",
    "check": "node scripts/check.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:scripts": "node --test scripts/test/*.test.mjs"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "5.0.1",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "7.0.2"
  },
  "type": "module",
  "dependencies": {
    "@trioditis/crypto": "workspace:*",
    "convex": "1.50.0"
  }
}
