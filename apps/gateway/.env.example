# The Convex deployment's URL (for local development, from packages/backend/.env.local).
CONVEX_URL=http://127.0.0.1:3210
# Shared with the Convex deployment (npx convex env set GATEWAY_SECRET ...).
GATEWAY_SECRET=
# Shared with every bridge host process.
TRIODITIS_INTERNAL_TOKEN=
# Where the gateway listens for bridge hosts. Never expose this publicly.
GATEWAY_INTERNAL_ADDR=127.0.0.1:8601
# The server's agent-access public key, base64url X25519.
AGENT_ACCESS_PUBLIC_KEY=
# Where each bridge host process takes commands: <hostId>=<url>, comma-separated.
BRIDGE_HOSTS=whatsapp-1=http://127.0.0.1:8611
