# Copy to .env.local. The Convex deployment's client URL.
VITE_CONVEX_URL=http://127.0.0.1:3210
# Where the app reaches Better Auth: its own origin. The dev server forwards /api/auth to
# AUTH_PROXY_TARGET, the deployment's HTTP actions, so the session cookie stays first-party.
# The deployment's SITE_URL must equal this origin.
VITE_CONVEX_SITE_URL=http://127.0.0.1:5173
AUTH_PROXY_TARGET=http://127.0.0.1:3211
VITE_TRIODITIS_ENVIRONMENT=development
VITE_PORT=5173
