# Copy to .env.local, or let `pnpm dev` pass these per worktree.
# The Convex deployment's client URL, and its HTTP-actions URL. The dev server proxies
# /api/auth, /mcp and the OAuth discovery documents to the second, so the app reaches them on
# its own origin. The deployment's SITE_URL must be this app's origin.
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211
VITE_TRIODITIS_ENVIRONMENT=development
# Where the dev server listens (strict: it fails rather than pick another). Set HOST to listen
# on every interface instead of 127.0.0.1.
PORT=5173
