{
  "name": "@trioditis/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Trioditis: your chat networks in one place",
  "author": "Trioditis contributors",
  "homepage": "https://trioditis.app",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist-electron/main.js",
  "desktopName": "trioditis.desktop",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p electron --noEmit",
    "test": "vitest run",
    "app": "tsc -p electron && node node_modules/electron/install.js && electron .",
    "package": "tsc -p electron && electron-builder",
    "package:dir": "tsc -p electron && electron-builder --dir",
    "package:linux": "tsc -p electron && electron-builder --linux",
    "package:mac": "tsc -p electron && electron-builder --mac",
    "package:win": "tsc -p electron && electron-builder --win"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.25",
    "@convex-dev/better-auth": "0.13.0",
    "@convex-dev/react-query": "0.1.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@trioditis/backend": "workspace:*",
    "@trioditis/core": "workspace:*",
    "@trioditis/crypto": "workspace:*",
    "@trioditis/ui": "workspace:*",
    "better-auth": "1.7.25",
    "convex": "1.50.0",
    "convex-helpers": "0.1.135",
    "lucide-react": "1.70.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-plugin": "1.169.0",
    "@trioditis/config": "workspace:*",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "happy-dom": "20.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
