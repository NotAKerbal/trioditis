#!/bin/sh
# `docker compose` for this install, with its settings. Usage: deploy/trioditis <compose args>
# e.g. `deploy/trioditis ps`, `deploy/trioditis logs -f gateway`, `deploy/trioditis down`.
# Also `deploy/trioditis backup <dir>`, `deploy/trioditis restore <archive>` and
# `deploy/trioditis create-admin <email>`: see docs/deploy.md.
#
# Backup and restore never act on a file or volume on the strength of an earlier look at it,
# since another process could change it in between. Volumes are held by a container of this
# command (Docker won't remove or replace a volume a container uses) before they're checked,
# and are removed only by a label unique to this run, matched by Docker itself. Files are
# written in a private directory and published with links that fail if anything is there.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
env_file="$here/.env"
if [ ! -f "$env_file" ]; then
  echo "No install here yet. Run deploy/install/install.sh first." >&2
  exit 1
fi
# The project is the one this install saved (installs from before it was saved use the
# default), whatever COMPOSE_PROJECT_NAME says: it names the volumes that hold the data.
project=$(grep -E '^COMPOSE_PROJECT_NAME=' "$env_file" | tail -1 | cut -d= -f2-)
project=${project:-trioditis}
# Exported COMPOSE_* variables would override .env, so they're dropped. Compose reads
# COMPOSE_FILE and COMPOSE_PROFILES from .env relative to where it runs, so it runs in the
# compose directory; this script stays where it was called, so paths given to it mean what
# they say.
unset COMPOSE_PROJECT_NAME COMPOSE_FILE COMPOSE_PROFILES
compose() { (cd "$here/compose" && docker compose --env-file "$env_file" -p "$project" "$@"); }

# The archive tool: the bundle's pinned Alpine-based image, which has tar and gzip.
tool=alpine/socat:1.8.0.3@sha256:beb4a68d9e4fe6b0f21ea774a0fde6c31f580dde6368939ed70100c5385b015e
# Written last into every archive, so an archive cut short anywhere has none. It lists each
# volume with its number of entries and bytes, which a restore checks its extraction against.
manifest=trioditis-backup.manifest

# An interrupted command exits, so its EXIT cleanup runs too.
trap 'exit 130' INT TERM HUP

# Every volume of this project, found by the label Compose gives them, so a dropped network's
# volume is included and another install's never is.
project_volumes() {
  docker volume ls -q --filter "label=com.docker.compose.project=$project" | sort
}

# A volume's labels, by key; empty if it has no such label.
volume_label() {
  docker volume inspect -f "{{index .Labels \"$2\"}}" "$1"
}

# One backup, restore or install of this install at a time: they stop and start the server
# under each other, and a restore could read volumes a backup is writing. install.sh takes
# the same lock.
take_lock() {
  command -v flock >/dev/null || { echo "Backup and restore need flock (util-linux)." >&2; exit 1; }
  exec 9>"$here/.operation.lock"
  flock -n 9 || { echo "Another backup, restore or install of this install is running." >&2; exit 1; }
}

random_hex() { od -An -N8 -tx1 /dev/urandom | tr -d ' \n'; }

# The device and inode of a file, to tell that a published path is the file written.
file_id() { stat -c '%d:%i' "$1"; }

# Publishes private file $1 at $2 as a hard link. `ln -T` fails if anything is at $2 (a file,
# a directory, a link), and the result is checked to be a regular file that is $1 itself.
# Returns 2 if the name was taken, 1 on any other failure.
publish() {
  if ! ln -T "$1" "$2" 2>/dev/null; then
    if [ -e "$2" ] || [ -L "$2" ]; then return 2; fi
    return 1
  fi
  [ -f "$2" ] && [ ! -L "$2" ] && [ "$(file_id "$2")" = "$(file_id "$1")" ] || return 1
}

# Removes path $2 only if it is still private file $1's link.
unpublish() {
  [ "$(file_id "$2" 2>/dev/null)" != "$(file_id "$1")" ] || rm -f "$2"
}

case "${1:-}" in
  backup)
    [ $# -eq 2 ] || { echo "Usage: deploy/trioditis backup <directory outside the checkout>" >&2; exit 2; }
    mkdir -p "$2"
    checkout=$(cd "$here/.." && pwd -P)
    # Real paths, so a symlink can't lead the backup into the checkout; checked again before
    # the files are published.
    outside_checkout() {
      real=$(cd "$1" && pwd -P) || return 1
      case "$real/" in "$checkout"/*) return 1 ;; esac
      echo "$real"
    }
    dir=$(outside_checkout "$2") || { echo "Back up outside the checkout: image builds copy it." >&2; exit 2; }
    take_lock
    # Everything the backup writes is the caller's alone.
    umask 077
    nonce=$(random_hex)
    worker="$project-backup-$nonce"
    # Both files are written in a directory of this backup's own (mktemp: new, 0700, the
    # caller's), where nothing else can create or swap them, so they're private from the first
    # byte and can be removed from any directory, a sticky one such as /tmp included.
    work=$(mktemp -d "$dir/.$project-backup-XXXXXX")
    running=$(compose ps --services --status running | tr '\n' ' ')
    published=''
    # However it ends, even interrupted while stopping: the archive container goes first, so
    # nothing still reads the volumes; this backup's directory goes; and what was running
    # starts again once any stop still under way in Docker has finished. A second interrupt
    # can't cut this short, no step's failure skips the next, and a server that doesn't start
    # again makes the backup a failure.
    finish_backup() {
      status=$?
      trap '' INT TERM HUP
      docker rm -f "$worker" >/dev/null 2>&1 || true
      rm -rf "$work" || true
      if [ -n "$running" ]; then
        compose stop >/dev/null 2>&1 || true
        # shellcheck disable=SC2086 # $running is a list of services
        if ! compose start $running >/dev/null 2>&1; then
          echo "The server didn't start again after the backup: run deploy/trioditis up -d." >&2
          status=1
        fi
      fi
      if [ "$status" = 0 ]; then
        echo "Backed up $(echo "$volumes" | wc -l | tr -d ' ') volumes of project $project to $published.tgz, and the secrets to $published.env."
        echo "Both hold private data: keep them encrypted."
      else
        echo "The backup failed." >&2
      fi
      exit "$status"
    }
    trap finish_backup EXIT

    volumes=$(project_volumes)
    [ -n "$volumes" ] || { echo "No volumes for project $project." >&2; exit 1; }
    # Stopped, so the databases are consistent.
    compose stop
    mounts=''
    members=''
    for volume in $volumes; do
      mounts="$mounts -v $volume:/volumes/$volume:ro"
      members="$members ./$volume"
    done
    # Created first, the worker holds every volume; each is then checked to still be this
    # project's (a volume gone since the listing would have been made anew, unlabelled).
    # With --init it gets an interrupt, and tar runs in the background so the shell's trap
    # stops it straight away.
    # shellcheck disable=SC2086 # $mounts is a list of -v options
    docker create --init --name "$worker" --log-driver none $mounts \
      -e MEMBERS="$members" -e MANIFEST="$manifest" \
      --entrypoint sh "$tool" -c '
        trap "kill \$tar_pid 2>/dev/null; exit 130" INT TERM
        cd /volumes
        {
          echo "trioditis-backup 1"
          for volume in $MEMBERS; do
            entries=$(find "$volume" | wc -l)
            bytes=$(find "$volume" -type f -exec stat -c %s {} + | awk "{ s += \$1 } END { print s + 0 }")
            echo "volume ${volume#./} $entries $bytes"
          done
        } >"$MANIFEST"
        tar -czf - $MEMBERS "./$MANIFEST" & tar_pid=$!
        wait "$tar_pid"' >/dev/null
    for volume in $volumes; do
      [ "$(volume_label "$volume" com.docker.compose.project)" = "$project" ] ||
        { echo "Volume $volume changed during the backup." >&2; exit 1; }
    done
    docker start -a "$worker" >"$work/archive.tgz"
    cat "$env_file" >"$work/secrets.env"

    # Published under a name no earlier backup there has, both files or neither: an existing
    # file is never replaced (a -2, -3... suffix instead), and if the .env can't be published
    # the archive is taken back.
    [ "$(outside_checkout "$dir")" = "$dir" ] || { echo "The backup directory moved into the checkout." >&2; exit 1; }
    stamp="$dir/$project-$(date +%Y%m%d-%H%M%S)"
    n=1
    while :; do
      name=$stamp
      [ "$n" = 1 ] || name="$stamp-$n"
      if publish "$work/archive.tgz" "$name.tgz"; then
        if publish "$work/secrets.env" "$name.env"; then break; else result=$?; fi
        unpublish "$work/archive.tgz" "$name.tgz"
      else
        result=$?
      fi
      [ "$result" = 2 ] || { echo "Couldn't write the backup to $dir." >&2; exit 1; }
      n=$((n + 1))
      [ "$n" -le 100 ] || { echo "No free name for the backup in $dir." >&2; exit 1; }
    done
    published=$name
    ;;
  restore)
    yes=0
    [ "${2:-}" != --yes ] || { yes=1; shift; }
    [ $# -eq 2 ] || { echo "Usage: deploy/trioditis restore [--yes] <archive.tgz>" >&2; exit 2; }
    [ -f "$2" ] || { echo "No archive at $2." >&2; exit 1; }
    archive_dir=$(cd "$(dirname "$2")" && pwd -P)
    archive_name=$(basename "$2")
    take_lock
    damaged() {
      echo "$2 can't be restored: $1. Nothing was changed." >&2
      exit 1
    }

    # What this restore makes is named, and labelled under keys, by a nonce of its own:
    # trioditis.restore.<nonce>.staging on its temporary volumes, .created on any target it
    # creates. Cleanup removes volumes only with `docker volume prune --filter label=<key>`,
    # which Docker matches itself, so a volume without this restore's key is never touched.
    # (Docker's prune ignores a label's value, so the nonce is in the key.)
    nonce=$(random_hex)
    suffix="restore-$nonce"
    worker="$project-$suffix"
    holder="$project-$suffix-archive"
    staging_label="trioditis.restore.$nonce.staging"
    created_label="trioditis.restore.$nonce.created"
    archive_volume="$project-$suffix-archive"
    restored=0
    # However it ends: the containers go first (they hold the volumes), then this restore's
    # temporary volumes, and the targets it created unless the restore finished.
    finish_restore() {
      status=$?
      trap '' INT TERM HUP
      docker rm -f "$worker" "$holder" >/dev/null 2>&1 || true
      docker volume prune -af --filter "label=$staging_label" >/dev/null 2>&1 || true
      [ "$restored" = 1 ] || docker volume prune -af --filter "label=$created_label" >/dev/null 2>&1 || true
      exit "$status"
    }
    trap finish_restore EXIT

    # The archive is copied once into a volume of this restore's own, held by a container from
    # just after it's created, and only that copy is read from here on, so a file changed after
    # it's checked can't be the one applied.
    docker volume create --label "$staging_label=1" "$archive_volume" >/dev/null
    docker create --name "$holder" -v "$archive_volume:/archive" "$tool" >/dev/null
    [ "$(volume_label "$archive_volume" "$staging_label")" = 1 ] || { echo "Volume $archive_volume isn't this restore's." >&2; exit 1; }
    docker run --rm --log-driver none -v "$archive_dir:/source:ro" -v "$archive_volume:/archive" \
      -e NAME="$archive_name" --entrypoint sh "$tool" -c 'cp "/source/$NAME" /archive/archive.tgz'

    # The whole copy is checked before anything changes: its compression, a full listing, and
    # the manifest, which must be its last entry. The manifest names the volumes.
    if ! listing=$(docker run --rm --log-driver none -v "$archive_volume:/archive:ro" \
      -e MANIFEST="$manifest" --entrypoint sh "$tool" -c '
        archive=/archive/archive.tgz
        gzip -t "$archive" && tar -tzf "$archive" >/tmp/list || exit 1
        [ "$(tail -1 /tmp/list)" = "./$MANIFEST" ] || exit 2
        tar -xzOf "$archive" "./$MANIFEST" && echo "dirs $(sed -n "s#^\./\([^/][^/]*\)/.*#\1#p" /tmp/list | sort -u | tr "\n" " ")"' 2>/dev/null); then
      damaged "it's damaged, cut short, or not a backup from deploy/trioditis backup" "$2"
    fi
    [ "$(echo "$listing" | head -1)" = "trioditis-backup 1" ] || damaged "its manifest isn't one this version reads" "$2"
    volumes=$(echo "$listing" | awk '$1 == "volume" { print $2 }' | sort)
    [ -n "$volumes" ] || damaged "its manifest lists no volumes" "$2"
    volume_list=$(echo "$volumes" | tr '\n' ' ')
    [ "$volume_list" = "$(echo "$listing" | awk '$1 == "dirs" { $1 = ""; print }' | tr ' ' '\n' | sed '/^$/d' | sort | tr '\n' ' ')" ] ||
      damaged "its contents don't match its manifest" "$2"

    # Each must be one of this project's volumes: the name past the project must be one of the
    # bundle's (so project "a" never takes project "a_b"'s). A missing one is created now,
    # labelled as Compose labels its own (so it adopts it) and with this restore's key; each
    # gets a fresh staging volume.
    mounts="-v $archive_volume:/archive:ro"
    created=''
    for volume in $volumes; do
      case "$volume" in
        "${project}_"*) key=${volume#"${project}"_} ;;
        *) key='' ;;
      esac
      case "$key" in
        postgres | convex | caddy-data | caddy-config | bridge-*) ;;
        *) echo "$2 holds volume $volume, which isn't project $project's. Restore it from the checkout of the install it came from." >&2; exit 1 ;;
      esac
      if ! docker volume inspect "$volume" >/dev/null 2>&1; then
        docker volume create --label "com.docker.compose.project=$project" \
          --label "com.docker.compose.volume=$key" --label "$created_label=1" "$volume" >/dev/null
        created="$created $volume"
      fi
      docker volume create --label "$staging_label=1" "$volume-$suffix" >/dev/null
      mounts="$mounts -v $volume:/target/$volume -v $volume-$suffix:/staging/$volume"
    done

    # One worker does it all, from the private copy: it checks the targets are exactly the
    # manifest's volumes; extracts into the staging volumes and checks each against the
    # manifest; and only then replaces each volume's contents with its staged copy, owner and
    # mode included. Created now, before anything is checked, it holds every volume, so what's
    # checked below is what it writes.
    # shellcheck disable=SC2086 # $mounts is a list of -v options
    docker create --init --name "$worker" --log-driver none $mounts \
      -e MANIFEST="$manifest" -e VOLUMES="$volume_list" --entrypoint sh "$tool" -c '
        archive=/archive/archive.tgz
        [ "$(ls /target | sort | tr "\n" " ")" = "$VOLUMES" ] || { echo "The volumes to restore changed." >&2; exit 5; }
        tar -xzf "$archive" -C /staging || { echo "Extracting the archive failed." >&2; exit 3; }
        [ "$(awk "\$1 == \"volume\" { print \$2 }" "/staging/$MANIFEST" | sort | tr "\n" " ")" = "$VOLUMES" ] || exit 3
        while read -r kind volume entries bytes; do
          [ "$kind" = volume ] || continue
          got_entries=$(find "/staging/$volume" | wc -l)
          got_bytes=$(find "/staging/$volume" -type f -exec stat -c %s {} + | awk "{ s += \$1 } END { print s + 0 }")
          if [ "$got_entries $got_bytes" != "$entries $bytes" ]; then
            echo "$volume extracted as $got_entries entries and $got_bytes bytes, but the manifest says $entries and $bytes." >&2
            exit 3
          fi
        done <"/staging/$MANIFEST"
        echo "Extracted and checked; replacing the volumes'"'"' contents."
        for volume in $VOLUMES; do
          target=/target/$volume
          staged=/staging/$volume
          find "$target" -mindepth 1 -delete &&
            cp -a "$staged/." "$target/" &&
            chown "$(stat -c %u:%g "$staged")" "$target" &&
            chmod "$(stat -c %a "$staged")" "$target" || exit 4
        done' >/dev/null
    # Now held, every volume is checked: each target carries Compose's labels for this project
    # and that volume (one this restore created also its key, so another that appeared under
    # its name first is refused), and every staging volume is this restore's.
    for volume in $volumes; do
      key=${volume#"${project}"_}
      labels="$(volume_label "$volume" com.docker.compose.project)|$(volume_label "$volume" com.docker.compose.volume)"
      if [ "$labels" != "$project|$key" ]; then
        echo "Volume $volume isn't this install's (its Compose project and volume labels are '$labels', not '$project|$key'). Nothing was changed." >&2
        exit 1
      fi
      case " $created " in
        *" $volume "*)
          [ "$(volume_label "$volume" "$created_label")" = 1 ] ||
            { echo "Volume $volume appeared while this restore was creating it. Nothing was changed." >&2; exit 1; }
          ;;
      esac
      [ "$(volume_label "$volume-$suffix" "$staging_label")" = 1 ] ||
        { echo "Volume $volume-$suffix isn't this restore's. Nothing was changed." >&2; exit 1; }
    done

    echo "This replaces the contents of: $volume_list"
    if [ "$yes" = 0 ]; then
      [ -t 0 ] || { echo "Pass --yes to restore without a prompt." >&2; exit 2; }
      printf 'Stop project %s and restore? [y/N] ' "$project"
      read -r answer
      [ "$answer" = y ] || [ "$answer" = Y ] || exit 1
    fi
    compose --profile '*' down
    if docker start -a "$worker"; then
      restored=1
      echo "Restored. Check deploy/.env is the one saved with this backup, then run deploy/install/install.sh to start the server."
    else
      case "$(docker inspect -f '{{.State.ExitCode}}' "$worker" 2>/dev/null)" in
        3) echo "The archive didn't extract as its manifest says. The volumes weren't changed; the server is stopped." >&2 ;;
        5) echo "The volumes to restore changed. They weren't changed; the server is stopped." >&2 ;;
        *) echo "The restore stopped while replacing the volumes' contents, so they're incomplete. The archive is intact: run the restore again." >&2 ;;
      esac
      exit 1
    fi
    ;;
  create-admin)
    [ $# -eq 2 ] || { echo "Usage: deploy/trioditis create-admin <email>" >&2; exit 2; }
    [ -t 0 ] || { echo "create-admin asks for the password, so run it in a terminal." >&2; exit 2; }
    # Asked here without echo (back on however it ends) and handed to the container by name,
    # so it's never an argument.
    trap 'stty echo 2>/dev/null || true' EXIT
    stty -echo
    printf 'Password for %s: ' "$2"
    read -r TRIODITIS_ADMIN_PASSWORD
    printf '\nAgain: '
    read -r again
    stty echo
    printf '\n'
    [ "$TRIODITIS_ADMIN_PASSWORD" = "$again" ] || { echo "The passwords don't match." >&2; exit 1; }
    export TRIODITIS_ADMIN_PASSWORD
    compose run --rm --no-deps -T -e TRIODITIS_ADMIN_PASSWORD --entrypoint node functions \
      deploy/scripts/create-admin.ts "$2"
    ;;
  *)
    cd "$here/compose"
    exec docker compose --env-file "$env_file" -p "$project" "$@"
    ;;
esac
