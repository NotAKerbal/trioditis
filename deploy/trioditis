#!/bin/sh
# `docker compose` for this install, with its settings. Usage: deploy/trioditis <compose args>
# e.g. `deploy/trioditis ps`, `deploy/trioditis logs -f gateway`, `deploy/trioditis down`.
# Also `deploy/trioditis backup <dir>`, `deploy/trioditis restore <backup>`,
# `deploy/trioditis keys export|import <file>` and `deploy/trioditis create-admin <email>`:
# see docs/deploy.md.
#
# What backup guards against (docs/deploy.md, Backup): the operator's mistakes, a second
# trioditis command at the same time, other Compose projects on the same Docker, interrupts,
# full disks and read-only filesystems, and steps that fail partway. The checkout and the
# backup directory are writable only by the operator, so not against a hostile process
# running as the same user that rewrites paths while a command runs.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
env_file="$here/.env"
# The one parser and writer for deploy/.env and key files: env_check, env_value, env_names,
# env_write.
# shellcheck source=deploy/scripts/env.sh
. "$here/scripts/env.sh"
env_names_file="$here/install/env-names"
# One backup, install or other write command for this install at a time: they stop and
# start the server under each other. install.sh takes the same lock. A command run by one
# that holds it (the updater's backup and restore, or a restore's own backup and install) is
# handed the lock on descriptor 9 and uses it as it is: a lock it holds is this run's, and one
# anyone else holds still stops it.
take_lock() {
  command -v flock >/dev/null || { echo "This command needs flock (util-linux)." >&2; exit 1; }
  if ! { [ -e /dev/fd/9 ] && [ /dev/fd/9 -ef "$here/.operation.lock" ]; }; then exec 9>"$here/.operation.lock"; fi
  flock -n 9 || { echo "Another backup, install or change to this install is running." >&2; exit 1; }
}
# A restore takes the lock before anything else, so whether there's an install here is decided
# under it.
[ "${1:-}" != restore ] || take_lock
# A restore onto a checkout with no install yet (after losing the server) brings its own
# settings, from the backup and the key file; every other command needs the install's.
fresh=0
if [ "${1:-}" = restore ] && [ ! -e "$env_file" ] && [ ! -L "$env_file" ]; then
  fresh=1
elif [ ! -f "$env_file" ]; then
  echo "No install here yet. Run deploy/install/install.sh first, or restore a backup onto it with deploy/trioditis restore --keys <key file> <backup>." >&2
  exit 1
fi

# deploy/.env is read once, here, for everything below. A backup reads it only under the
# lock, from a private copy (the snapshot) that it then uses throughout; a restore reads it
# under the lock; everything else reads it in place. Its raw bytes are checked first: a NUL,
# which the shell would drop without a word, or a carriage return, is refused before anything
# reads it.
# A private directory in memory (the user's runtime directory, else /dev/shm) for what must
# never reach a disk in the clear: a backup's snapshot of deploy/.env (keys included), its
# settings before they're encrypted, and the keys' values its last check looks for.
memory_dir() {
  for base in "${XDG_RUNTIME_DIR:-}" /dev/shm; do
    [ -n "$base" ] && [ -d "$base" ] && [ -w "$base" ] || continue
    [ "$(stat -f -c %T "$base" 2>/dev/null)" = tmpfs ] || continue
    (umask 077 && mktemp -d "$base/trioditis-XXXXXX") && return 0
  done
  echo "This needs a memory-backed directory it can write (\$XDG_RUNTIME_DIR or /dev/shm), so a backup's settings never reach a disk in the clear." >&2
  return 1
}

env_source=$env_file
snapshot=''
plain=''
if [ "${1:-}" = backup ]; then
  take_lock
  { [ -f "$env_file" ] && [ ! -L "$env_file" ]; } || { echo "deploy/.env isn't a regular file." >&2; exit 1; }
  plain=$(memory_dir) || exit 1
  snapshot="$plain/env"
  trap 'rm -rf "$plain"' EXIT
  (umask 077 && cp "$env_file" "$snapshot")
  env_source=$snapshot
fi
if [ "$fresh" = 1 ]; then
  env_text=''
else
  env_raw_clean "$env_source" || { echo "deploy/.env holds a NUL or a carriage return. Fix it and run this again." >&2; exit 1; }
  env_text=$(cat "$env_source")
fi
# The project is the one this install saved (installs from before it was saved use the
# default), whatever COMPOSE_PROJECT_NAME says: it names the volumes that hold the data.
project=$(printf '%s\n' "$env_text" | env_value COMPOSE_PROJECT_NAME)
project=${project:-trioditis}
# deploy/.env is the only source of the install's settings and secrets, so every variable it
# sets, every one the compose files read, and every COMPOSE_* one (Compose's own settings,
# found in the environment, since new ones appear) are dropped here: an exported one
# would override the file, and the running stack would no longer match the .env a backup
# saves. Compose reads COMPOSE_FILE and COMPOSE_PROFILES from .env relative to where it runs,
# so it runs in the compose directory; this script stays where it was called, so paths given
# to it mean what they say.
for name in $( {
  printf '%s\n' "$env_text" | env_names
  grep -ohE '\$\{[A-Za-z_][A-Za-z0-9_]*' "$here"/compose/*.yml | cut -c3-
  env | sed -n 's/^\(COMPOSE_[A-Za-z0-9_]*\)=.*/\1/p'
} | sort -u); do
  unset "$name"
done
compose() { (cd "$here/compose" && docker compose --env-file "$env_source" -p "$project" "$@"); }

# The archive tool: the bundle's pinned Alpine-based image, which has tar (and gzip, for
# reading backups from before archives were left uncompressed).
tool=alpine/socat:1.8.0.3@sha256:beb4a68d9e4fe6b0f21ea774a0fde6c31f580dde6368939ed70100c5385b015e
# Written last into every archive, so an archive cut short anywhere has none. It lists each
# volume with its number of entries and bytes, for a restore to check its extraction against.
manifest=trioditis-backup.manifest

# An interrupted command exits, so its EXIT cleanup runs too.
trap 'exit 130' INT TERM HUP

# Every volume of this project, found by the label Compose gives them, so a dropped network's
# volume is included and another install's never is.
project_volumes() {
  docker volume ls -q --filter "label=com.docker.compose.project=$project" | sort
}

random_hex() { od -An -N8 -tx1 /dev/urandom | tr -d ' \n'; }

# The bundle's Node image (as in deploy/docker/node.Dockerfile), for deriving public keys.
node_image=node:24.21-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20
# Reads "<name> <X25519 private key, base64url>" lines on stdin and prints "<name> <its public
# key>" for each, in a container with no network that logs nothing: the keys never become
# arguments or reach a log.
node_ready() { docker image inspect "$node_image" >/dev/null 2>&1 || docker pull -q "$node_image" >/dev/null; }
derive_public_keys() {
  node_ready
  docker run --rm -i --network none --log-driver none "$node_image" node -e "
    const { createPrivateKey, createPublicKey } = require('node:crypto')
    let input = ''
    process.stdin.on('data', (data) => (input += data)).on('end', () => {
      for (const line of input.split('\\n').filter(Boolean)) {
        const [name, privateKey] = line.split(' ')
        const raw = Buffer.from(privateKey, 'base64url')
        if (raw.length !== 32) { console.log(name + ' invalid'); continue }
        const pkcs8 = Buffer.concat([Buffer.from('302e020100300506032b656e04220420', 'hex'), raw])
        const spki = createPublicKey(createPrivateKey({ key: pkcs8, format: 'der', type: 'pkcs8' }))
          .export({ format: 'der', type: 'spki' })
        console.log(name + ' ' + spki.subarray(-32).toString('base64url'))
      }
    })"
}

# crypt encrypt|decrypt KEY CONTEXT [NAME]: deploy/scripts/backup-crypt.mjs on stdin to stdout,
# with backup key KEY, for the file CONTEXT names (`<backup id>/archive` or `<backup id>/settings`,
# which binds it to its backup and role; empty for a file from before backups had an ID), in the
# bundle's Node image with no network and no log, as container NAME if given (for cleanup to
# remove). The key reaches it by name in its environment, never as an argument, and the script
# as the program's text, so nothing on the host need be shared with the container. Interrupts
# reach this script, not the container, which ends when its input does or cleanup removes it.
crypt() {
  node_ready
  BACKUP_KEY=$2 BACKUP_CONTEXT=$3 docker run --rm -i ${4:+--name "$4"} --network none --log-driver none --sig-proxy=false \
    -e BACKUP_KEY -e BACKUP_CONTEXT "$node_image" node --input-type=module -e "$(cat "$here/scripts/backup-crypt.mjs")" "$1"
}
# backup_id DIR: the ID a backup's files are bound to, from its backup.info; empty for one
# from before backups had one. Exits if it isn't in the form backup writes.
backup_id() {
  id=$(sed -n 's/^id=//p' "$1/backup.info" 2>/dev/null | head -1)
  [ -z "$id" ] || printf '%s\n' "$id" | grep -qxE '[A-Za-z0-9_-]{1,64}-[0-9]{1,12}-[0-9a-f]{16}' ||
    { echo "$1/backup.info has an ID that isn't one backup writes." >&2; exit 1; }
  printf '%s' "$id"
}
# The server's private keys, which open what's sealed to it: the bridge key (sends and login
# input) and the agent-access key (granted chats); and the backup key, which opens its backups.
# Backups leave them out; `keys` moves them.
private_keys='BRIDGE_PRIVATE_KEY|AGENT_ACCESS_PRIVATE_KEY|BACKUP_KEY'
key_names='BRIDGE_PUBLIC_KEY BRIDGE_PRIVATE_KEY AGENT_ACCESS_PUBLIC_KEY AGENT_ACCESS_PRIVATE_KEY BACKUP_KEY'
# The value of $1 in checked text $2.
value_in() { printf '%s\n' "$2" | env_value "$1"; }
# Reads deploy/.env (a regular file, not a link) once, into $env_text, and checks its form;
# refuses, naming the bad lines, if it isn't the one form.
read_env() {
  { [ -f "$env_file" ] && [ ! -L "$env_file" ]; } || { echo "deploy/.env isn't a regular file." >&2; exit 1; }
  env_raw_clean "$env_file" || { echo "deploy/.env holds a NUL or a carriage return. Fix it and run this again." >&2; exit 1; }
  env_text=$(cat "$env_file")
  check_env_text
}
# Checks $env_text's form; refuses, naming the bad lines, if it isn't the one form.
check_env_text() {
  if ! problems=$(printf '%s\n' "$env_text" | env_check); then
    echo "deploy/.env isn't all in the form the installer writes (NAME=value with a literal value, each name once):" >&2
    echo "$problems" | sed 's/^/  /' >&2
    echo "Fix those lines and run this again." >&2
    exit 1
  fi
}
# A private key as the installer writes one: canonical unpadded base64url of exactly 32
# bytes, and nothing else (43 characters, the last carrying no stray bits).
valid_key() {
  printf '%s\n' "$1" | grep -qxE '[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]'
}

# check_key_file FILE TEXT WHERE HINT: checks FILE, a key file as `keys export` writes it,
# against the public keys in checked text TEXT (deploy/.env, or a backup's settings, as WHERE
# names them; HINT says what to do if they're missing), and exits, nothing changed, unless each
# pair is TEXT's and each private key is exactly a key and its public key's private half (each
# derived, in the bundle's Node image with no network: no key is printed). A BACKUP_KEY in it
# must be exactly a key too. Leaves the file's checked text in key_file_text.
check_key_file() {
  { [ -r "$1" ] && [ ! -d "$1" ]; } || { echo "No key file at $1." >&2; exit 1; }
  # The raw bytes first: a NUL or a carriage return is refused before the shell reads the
  # file (it would drop a NUL without a word).
  [ "$(tr -d '\000\r' <"$1" | wc -c)" = "$(wc -c <"$1")" ] ||
    { echo "$1 holds a NUL or a carriage return, so it isn't a key file keys export wrote. Nothing was changed." >&2; exit 1; }
  key_file_text=$(cat "$1")
  if ! problems=$(printf '%s\n' "$key_file_text" | env_check); then
    echo "$1 isn't a key file in the form keys export writes:" >&2
    echo "$problems" | sed 's/^/  /' >&2
    echo "Nothing was changed." >&2
    exit 1
  fi
  # Each private key exactly as it must be; the value checked is the value derived from
  # and the value saved. (env_check has already held a BACKUP_KEY to the same form.)
  for pair in BRIDGE AGENT_ACCESS; do
    valid_key "$(value_in "${pair}_PRIVATE_KEY" "$key_file_text")" ||
      { echo "$1's ${pair}_PRIVATE_KEY isn't a key (43 characters of unpadded base64url, nothing else). Nothing was changed." >&2; exit 1; }
  done
  # Each private key's own public key, derived from it (no key is printed).
  derived=$(for pair in BRIDGE AGENT_ACCESS; do
    printf '%s %s\n' "$pair" "$(value_in "${pair}_PRIVATE_KEY" "$key_file_text")"
  done | derive_public_keys) || { echo "Couldn't check the keys (Docker is needed for that). Nothing was changed." >&2; exit 1; }
  for pair in BRIDGE AGENT_ACCESS; do
    public=$(value_in "${pair}_PUBLIC_KEY" "$key_file_text")
    [ -n "$public" ] || { echo "$1 has no complete ${pair} key pair. Nothing was changed." >&2; exit 1; }
    current=$(value_in "${pair}_PUBLIC_KEY" "$2")
    [ -n "$current" ] || { echo "$3 has no ${pair}_PUBLIC_KEY: $4. Nothing was changed." >&2; exit 1; }
    [ "$public" = "$current" ] || { echo "$1's ${pair} keys aren't this server's: the public key doesn't match $3's. Nothing was changed." >&2; exit 1; }
    [ "$(printf '%s\n' "$derived" | sed -n "s/^$pair //p")" = "$current" ] ||
      { echo "$1's ${pair}_PRIVATE_KEY isn't the private half of this server's ${pair} public key. Nothing was changed." >&2; exit 1; }
  done
}

case "${1:-}" in
  backup)
    # --keep-stopped (the updater's, and a restore's) leaves the server stopped once the backup
    # is made, so nothing it does afterwards is missing from the backup; a backup that fails
    # starts it again as usual.
    keep_stopped=0
    if [ "${2:-}" = --keep-stopped ]; then
      keep_stopped=1
      shift
    fi
    [ $# -eq 2 ] || { echo "Usage: deploy/trioditis backup [--keep-stopped] <directory outside the checkout>" >&2; exit 2; }
    # The snapshot of deploy/.env, read once under the lock (above), is the project, the
    # settings Compose runs with, and secrets.env, for the whole backup. It's checked before
    # anything is made.
    # The lock was taken and the snapshot read above, before anything else; it's checked now.
    check_env_text
    # Every file a backup keeps is encrypted with BACKUP_KEY, which the installer makes and
    # which, like the private keys, is never in a backup.
    backup_key=$(value_in BACKUP_KEY "$env_text")
    [ -n "$backup_key" ] || {
      echo "deploy/.env has no BACKUP_KEY, which encrypts backups. Run deploy/install/install.sh, which makes it, then export the keys again (deploy/trioditis keys export <file>)." >&2
      exit 1
    }
    # When the backup's data stops changing: taken before the server stops, so it's never later.
    created=$(date +%s)
    version=$(value_in TRIODITIS_VERSION "$env_text")
    # Everything the backup writes is the caller's alone.
    umask 077
    # Real paths, so a symlink can't lead the backup into the checkout: resolved and checked
    # before anything is made, and checked again once the directory exists.
    checkout_dir=$(cd "$here/.." && pwd -P)
    outside() {
      case "$1/" in "$checkout_dir"/*) echo "Back up outside the checkout: image builds copy it." >&2; exit 2 ;; esac
    }
    planned=$(realpath -m -- "$2") || { echo "Can't resolve $2." >&2; exit 2; }
    outside "$planned"
    mkdir -p "$2"
    dir=$(cd "$2" && pwd -P)
    outside "$dir"
    # The settings in the clear, and the keys' values the last check looks for, stay in memory,
    # beside the snapshot ($plain, made above).
    worker="$project-backup-$(random_hex)"
    # What the backup's files are bound to (crypt), so they only decrypt together.
    id="$project-$created-$(random_hex)"
    # A backup is a directory holding the archive and the .env. It's assembled in a new
    # private directory beside where it goes, and published with one rename that fails if
    # anything is at the name, so there's either a whole backup there or none, and nothing
    # already there is ever replaced. Until then cleanup only ever touches this directory.
    work=$(mktemp -d "$dir/.$project-backup-XXXXXX")
    published=''
    reserved=''
    running=''
    left_out=''
    # However it ends, even interrupted while stopping: the archive container goes first, so
    # nothing still reads the volumes; the unpublished directory goes; and the containers
    # that were running start again, in order, once any stop still under way in Docker has
    # finished. A second interrupt can't cut this short, no step's failure skips the next, and
    # a server that doesn't start again makes the backup a failure.
    finish_backup() {
      status=$?
      trap '' INT TERM HUP
      docker rm -f "$worker" "$worker-crypt" >/dev/null 2>&1 || true
      [ -z "$work" ] || rm -rf "$work" || true
      # The settings in the clear go now; the snapshot (Compose's settings) once the server is
      # started again.
      rm -f "$plain/secrets.env" "$plain/.patterns" || true
      # Only a name this backup made (recorded once mkdir succeeded), and only while empty.
      [ -z "$reserved" ] || rmdir "$reserved" 2>/dev/null || true
      if [ -n "$running" ] && [ "$keep_stopped" = 1 ] && [ "$status" = 0 ]; then
        # Kept stopped, as asked: whatever starts it next (the installer) picks up from here.
        compose stop >/dev/null 2>&1 || true
        echo "The server is left stopped, as asked (--keep-stopped)."
      elif [ -n "$running" ]; then
        compose stop >/dev/null 2>&1 || true
        restart_running || {
          echo "The server didn't start again after the backup: run deploy/trioditis up -d." >&2
          status=1
        }
      fi
      rm -rf "$plain"
      if [ "$status" = 0 ]; then
        echo "Backed up project $project to $published (archive.enc, and the settings in secrets.env.enc), encrypted with BACKUP_KEY."
        [ -z "$left_out" ] || echo "Left out of secrets.env, as settings the installer doesn't write (keep them yourself if you need them):$left_out"
        echo "The server's keys aren't in it: BACKUP_KEY opens the backup, and the private keys what's sealed to the server."
        echo "Keep them apart from your backups (a password manager, or offline media): deploy/trioditis keys export <file>."
        echo "Without them the backup can't be restored."
      else
        echo "The backup failed." >&2
      fi
      exit "$status"
    }
    # Starts again exactly the containers that were running (not a finished one-shot, such as
    # the functions job), in the order their dependencies need, each healthy before the next
    # step: the database, the backend, Caddy, the gateway, then the bridge hosts and sidecars.
    restart_running() {
      for step in postgres backend caddy gateway 'bridge-*' '*'; do
        started=''
        for entry in $running; do
          id=${entry%%=*}
          service=${entry#*=}
          case " $done_ids " in *" $id "*) continue ;; esac
          # shellcheck disable=SC2254 # $step is a pattern
          case "$service" in $step) ;; *) continue ;; esac
          docker start "$id" >/dev/null || return 1
          started="$started $id"
          done_ids="$done_ids $id"
        done
        # Each healthy (or running, without a healthcheck) within two minutes, or the next
        # step doesn't start.
        # A container that's still running may yet recover (a healthcheck can fail once while
        # it starts), so only one that has stopped ends the wait early.
        for id in $started; do
          ready=0
          state=unknown
          deadline=$(($(date +%s) + 120))
          while left=$((deadline - $(date +%s))) && [ "$left" -gt 0 ]; do
            state=$(timeout "$left" docker inspect -f '{{.State.Status}}/{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$id" 2>/dev/null) || state=unknown
            case "$state" in running/healthy | running/none) ready=1 && break ;; exited/* | dead/*) break ;; esac
            sleep 1
          done
          if [ "$ready" = 0 ]; then
            echo "$(printf '%s\n' "$running" | sed -n "s/^$id=//p") didn't become healthy ($state), so what depends on it wasn't started." >&2
            return 1
          fi
        done
      done
    }
    done_ids=''
    trap finish_backup EXIT
    # The containers running now, as id=service, recorded before anything stops; empty if
    # none is, so a cold backup starts nothing.
    running=$(docker ps --filter "label=com.docker.compose.project=$project" \
      --format '{{.ID}}={{.Label "com.docker.compose.service"}}')

    volumes=$(project_volumes)
    [ -n "$volumes" ] || { echo "No volumes for project $project." >&2; exit 1; }
    # Stopped, so the databases are consistent.
    compose stop
    mounts=''
    members=''
    for volume in $volumes; do
      mounts="$mounts -v $volume:/volumes/$volume:ro"
      members="$members ./$volume"
    done
    # With --init the container gets an interrupt, and tar runs in the background so the
    # shell's trap stops it straight away. The manifest also says when the backup was taken,
    # from which version, and the Postgres major version its data is for, for a restore to
    # check. The archive goes straight into the encryption, so it never reaches the disk in
    # the clear; each half's exit status is checked, the archive's through a file.
    # It isn't compressed: the volumes are mostly sealed content and media, which gzip barely
    # shrinks (about 0.1%), and busybox's single-threaded gzip made the backup, and so the time
    # the server is stopped for an update, several times longer. backup.info says format=3 so
    # a restore knows; older backups (format 2 and before) are gzip.
    archived="$work/.archived"
    # shellcheck disable=SC2086 # $mounts is a list of -v options
    {
      docker run --rm --init --name "$worker" --log-driver none $mounts \
        -e MEMBERS="$members" -e MANIFEST="$manifest" -e CREATED="$created" -e VERSION="${version:-unknown}" -e ID="$id" \
        -e PGDATA_DIR="./${project}_postgres" \
        --entrypoint sh "$tool" -c '
          trap "kill \$tar_pid 2>/dev/null; exit 130" INT TERM
          cd /volumes
          {
            echo "trioditis-backup 2"
            echo "created $CREATED"
            echo "version $VERSION"
            echo "id $ID"
            [ ! -f "$PGDATA_DIR/PG_VERSION" ] || echo "postgres $(cat "$PGDATA_DIR/PG_VERSION")"
            for volume in $MEMBERS; do
              entries=$(find "$volume" | wc -l)
              bytes=$(find "$volume" -type f -exec stat -c %s {} + | awk "{ s += \$1 } END { print s + 0 }")
              echo "volume ${volume#./} $entries $bytes"
            done
          } >"$MANIFEST"
          tar -cf - $MEMBERS "./$MANIFEST" & tar_pid=$!
          wait "$tar_pid"'
      echo "$?" >"$archived"
    } | crypt encrypt "$backup_key" "$id/archive" "$worker-crypt" >"$work/archive.enc" ||
      { echo "Couldn't encrypt the archive. Nothing was published." >&2; exit 1; }
    [ "$(cat "$archived" 2>/dev/null)" = 0 ] || { echo "Couldn't archive the volumes. Nothing was published." >&2; exit 1; }
    rm -f "$archived"
    # secrets.env holds only the settings listed in deploy/install/env-names, each as
    # NAME=value from the snapshot: never the private keys (a backup holds sealed content,
    # and they open it: docs/architecture/sealing.md, Bridge key exposure), and nothing else,
    # not even a comment. A name deploy/.env has that isn't listed stays out, and is named
    # below (its value isn't) for the operator to keep.
    # One pass over the snapshot's settings, every lookup checked: a step that fails stops the
    # backup, rather than reading as a setting that isn't there.
    copy_failed() {
      echo "Couldn't copy the settings into secrets.env. Nothing was published." >&2
      exit 1
    }
    allowed=$(sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)$/\1/p' "$env_names_file") || copy_failed
    # shellcheck disable=SC2086 # one name per word
    allowed=" $(printf '%s ' $allowed)"
    present=$(env_names <"$snapshot") || copy_failed
    kept=0
    : >"$plain/secrets.env"
    for name in $present; do
      case "$name" in BRIDGE_PRIVATE_KEY | AGENT_ACCESS_PRIVATE_KEY | BACKUP_KEY) continue ;; esac
      case "$allowed" in *" $name "*) ;; *) left_out="$left_out $name" && continue ;; esac
      value=$(env_value "$name" <"$snapshot") || copy_failed
      printf '%s=%s\n' "$name" "$value" >>"$plain/secrets.env" || copy_failed
      kept=$((kept + 1))
    done
    # Then checked again, by a second reader: every listed setting the snapshot has is in
    # secrets.env once, with its value, and nothing else is.
    verified=$(env_kept "$env_names_file" "$snapshot" "$plain/secrets.env") || verified=failed
    if [ "$verified" != "$kept" ]; then
      echo "secrets.env doesn't hold exactly the listed settings from deploy/.env. Nothing was published." >&2
      exit 1
    fi
    # And a last check that no key's value (the private keys, or the backup key) is anywhere in
    # it, by any name. The values go in a private patterns file, never arguments. Each step is
    # checked: secrets.env counts as clean only if grep found nothing (exit 1) with exactly as
    # many patterns as there are keys; anything else, a step that failed included, publishes
    # nothing.
    patterns="$plain/.patterns"
    expected=0
    : >"$patterns"
    for key_name in BRIDGE_PRIVATE_KEY AGENT_ACCESS_PRIVATE_KEY BACKUP_KEY; do
      key_value=$(value_in "$key_name" "$env_text")
      [ -n "$key_value" ] || continue
      printf '%s\n' "$key_value" >>"$patterns"
      expected=$((expected + 1))
    done
    scan=0
    if [ "$expected" -gt 0 ]; then
      [ "$(wc -l <"$patterns" | tr -d ' ')" = "$expected" ] && [ "$(grep -c . "$patterns")" = "$expected" ] || scan=2
      [ "$scan" != 0 ] || grep -qFf "$patterns" "$plain/secrets.env" || scan=$?
    else
      scan=1
    fi
    rm -f "$patterns"
    case "$scan" in
      1) ;;
      0) echo "A private key's value is in another setting, so it would be in the backup. Nothing was published." >&2 && exit 1 ;;
      *) echo "Couldn't check secrets.env for the private keys. Nothing was published." >&2 && exit 1 ;;
    esac
    # Then it's encrypted like the archive, and the copy in the clear goes. backup.info says,
    # unencrypted, what a restore needs to know first: which version to check out to restore it.
    crypt encrypt "$backup_key" "$id/settings" "$worker-crypt" <"$plain/secrets.env" >"$work/secrets.env.enc" ||
      { echo "Couldn't encrypt secrets.env. Nothing was published." >&2; exit 1; }
    rm -f "$plain/secrets.env"
    printf 'format=3\nid=%s\nproject=%s\nversion=%s\ncreated=%s\n' "$id" "$project" "${version:-unknown}" "$created" >"$work/backup.info"

    # The name is reserved with mkdir, which fails if anything (a file, a directory, a link) is
    # there; then the private directory is renamed onto that empty one in one step, so the
    # pair of files appears whole or not at all. No exit status is taken on trust: after the
    # rename, the private directory must be gone and the name must hold both files. Making
    # the name and recording it happen with interrupts held off, so cleanup knows exactly the
    # names this backup made, and never one that was there already.
    stamp="$dir/$project-$(date +%Y%m%d-%H%M%S)"
    n=1
    name=$stamp
    while :; do
      trap '' INT TERM HUP
      made=0
      if mkdir "$name" 2>/dev/null; then
        reserved=$name
        made=1
      fi
      trap 'exit 130' INT TERM HUP
      [ "$made" = 0 ] || break
      [ -e "$name" ] || [ -L "$name" ] || { echo "Couldn't create the backup in $dir." >&2; exit 1; }
      n=$((n + 1))
      [ "$n" -le 100 ] || { echo "No free name for the backup in $dir." >&2; exit 1; }
      name="$stamp-$n"
    done
    if ! mv -T "$work" "$name" 2>/dev/null || [ -e "$work" ] || [ ! -f "$name/archive.enc" ] ||
      [ ! -f "$name/secrets.env.enc" ] || [ ! -f "$name/backup.info" ]; then
      echo "Couldn't publish the backup in $dir." >&2
      exit 1
    fi
    work=''
    reserved=''
    published=$name
    # The last backup of this install, for the installer: an upgrade that changes the database
    # images wants one made at the version it upgrades from.
    printf 'version=%s\ncreated=%s\npath=%s\n' "${version:-unknown}" "$created" "$name" >"$here/.last-backup" || true
    ;;
  restore)
    shift
    usage="Usage: deploy/trioditis restore [--yes] [--from-older-version] [--recovery-dir <dir>] [--keys <key file>] <backup directory>"
    assume_yes=0
    older=0
    recovery_parent=''
    key_file=''
    source=''
    while [ $# -gt 0 ]; do
      case "$1" in
        --yes) assume_yes=1 ;;
        --from-older-version) older=1 ;;
        --recovery-dir | --keys)
          [ $# -ge 2 ] || { echo "$usage" >&2; exit 2; }
          if [ "$1" = --keys ]; then key_file=$2; else recovery_parent=$2; fi
          shift
          ;;
        -*) echo "$usage" >&2; exit 2 ;;
        *) [ -z "$source" ] || { echo "$usage" >&2; exit 2; }; source=$1 ;;
      esac
      shift
    done
    [ -n "$source" ] || { echo "$usage" >&2; exit 2; }
    refuse() { echo "$*" >&2; echo "Nothing was changed." >&2; exit 1; }
    # A restore with no install that was cut off after it wrote deploy/.env (its marker says it
    # was one with no install, and names the RESTORE_ID that file has) is still that restore:
    # run again with its key file, it carries on as one with no install, the file being its own.
    if [ "$fresh" = 0 ] && [ -n "$key_file" ] && [ -f "$here/.restore-settle" ] &&
      grep -qx 'fresh=1' "$here/.restore-settle" && grep -qxE 'state=(loading|ready)' "$here/.restore-settle"; then
      marker_restore=$(sed -n 's/^restore_id=//p' "$here/.restore-settle")
      env_restore=$(sed -n 's/^RESTORE_ID=//p' "$env_file" 2>/dev/null || true)
      if [ -n "$marker_restore" ] && [ "$marker_restore" = "$env_restore" ]; then
        echo "Carrying on with the restore that was cut off (deploy/.env is its own)."
        fresh=1
        env_text=''
      fi
    fi
    # Under the lock (taken above), before anything else: deploy/.env as it is, checked, or,
    # with no install, the key file that brings the server's keys.
    if [ "$fresh" = 1 ]; then
      [ -n "$key_file" ] || { echo "There's no install here, so the server's keys must come with the backup: pass the file keys export wrote, --keys <file>." >&2; exit 2; }
      [ "$(tr -d '\000\r' <"$key_file" 2>/dev/null | wc -c)" = "$(wc -c <"$key_file" 2>/dev/null || echo x)" ] ||
        refuse "$key_file isn't a key file keys export wrote (or can't be read)."
      # Checked against its own public keys here (each private key their half), and against the
      # backup's once that's open.
      check_key_file "$key_file" "$(cat "$key_file")" "$key_file" "it isn't a whole key file"
      backup_key=$(value_in BACKUP_KEY "$key_file_text")
    else
      [ -z "$key_file" ] || { echo "--keys is for restoring onto a checkout with no install; this one has its keys in deploy/.env." >&2; exit 2; }
      read_env
      backup_key=$(value_in BACKUP_KEY "$env_text")
    fi
    source_dir=$(cd "$source" 2>/dev/null && pwd -P) || refuse "No backup at $source."
    if [ -f "$source_dir/archive.enc" ] && [ -f "$source_dir/secrets.env.enc" ]; then
      encrypted=1
      [ -n "$backup_key" ] || refuse "The backup is encrypted, and $([ "$fresh" = 1 ] && echo "$key_file" || echo deploy/.env) has no BACKUP_KEY to open it."
    elif [ -f "$source_dir/archive.tgz" ] && [ -f "$source_dir/secrets.env" ]; then
      # A backup from before they were encrypted.
      encrypted=0
      echo "warning: $source_dir is an older, unencrypted backup. Once restored, back up again and delete it." >&2
    else
      refuse "$source_dir isn't a backup deploy/trioditis backup made (no archive.enc and secrets.env.enc)."
    fi
    work=$(umask 077 && mktemp -d "${TMPDIR:-/tmp}/trioditis-restore-XXXXXX")
    trap 'rm -rf "$work"' EXIT
    # The ID both files are bound to: each decrypts only as its own backup's archive or settings.
    id=$(backup_id "$source_dir") || refuse "The backup's backup.info isn't one backup writes."
    # This restore's own ID: kept for good in deploy/.env as RESTORE_ID, which every bridge host
    # compares with the last restore its database settled (so it settles the restored queue
    # once, whichever volumes the backup had), and put on every volume it makes, so it only ever
    # empties a volume it made. With no install, a run of the same backup cut off before (its
    # marker names this backup) carries on with that run's ID and volumes.
    # What names the backup for that: its ID, or, for an older backup without one, a fingerprint
    # of its settings file and the start of its archive.
    if [ -n "$id" ]; then
      backup_key_id=$id
    elif [ "$encrypted" = 0 ]; then
      backup_key_id="legacy-$({ cat "$source_dir/secrets.env"; head -c 65536 "$source_dir/archive.tgz"; } | sha256sum | cut -c1-32)"
    else
      backup_key_id="legacy-$({ head -c 65536 "$source_dir/secrets.env.enc"; head -c 65536 "$source_dir/archive.enc"; } | sha256sum | cut -c1-32)"
    fi
    resume_id=''
    if [ "$fresh" = 1 ] && [ -f "$here/.restore-settle" ] &&
      [ "$(sed -n 's/^backup_id=//p' "$here/.restore-settle")" = "$backup_key_id" ]; then
      resume_id=$(sed -n 's/^restore_id=//p' "$here/.restore-settle" | grep -xE '[0-9]{1,12}-[0-9a-f]{16}' || true)
    fi
    restore_id=${resume_id:-$(date +%s)-$(random_hex)}
    # restore_label VOLUME: the restore that made VOLUME, if one did.
    restore_label() { docker volume inspect -f '{{index .Labels "trioditis.restore"}}' "$1" 2>/dev/null; }
    # Whether VOLUME is one the run this one carries on from made.
    resumed_volume() { [ -n "$resume_id" ] && [ "$(restore_label "$1")" = "$resume_id" ]; }
    # stream DIR: the backup's archive, decrypted and uncompressed, on stdout, as a plain tar.
    # Busybox tar can't tell gzip from tar on a pipe, so an older backup's gzip (any before
    # format=3, encrypted or not) is undone here, and every reader takes a plain tar. Each
    # half's exit status counts, the source's through a file.
    stream() {
      if [ "$encrypted" = 1 ] && grep -qx 'format=3' "$1/backup.info" 2>/dev/null; then
        stream_source "$1"
        return
      fi
      { stream_source "$1"; echo "$?" >"$work/stream-source"; } |
        docker run --rm -i --sig-proxy=false --log-driver none --entrypoint gzip "$tool" -dc || return 1
      [ "$(cat "$work/stream-source" 2>/dev/null)" = 0 ]
    }
    stream_source() {
      if [ "$encrypted" = 1 ]; then
        stream_id=$(backup_id "$1") || return 1
        crypt decrypt "$backup_key" "${stream_id:+$stream_id/archive}" <"$1/archive.enc"
      else
        cat "$1/archive.tgz"
      fi
    }

    # Its settings first: they say which server and which version it's from.
    if [ "$encrypted" = 1 ]; then
      backup_env=$(crypt decrypt "$backup_key" "${id:+$id/settings}" <"$source_dir/secrets.env.enc") ||
        refuse "Couldn't open the backup's secrets.env.enc with this BACKUP_KEY: it's another install's backup, or it's damaged."
    else
      env_raw_clean "$source_dir/secrets.env" || refuse "The backup's secrets.env holds a NUL or a carriage return."
      backup_env=$(cat "$source_dir/secrets.env")
    fi
    printf '%s\n' "$backup_env" | env_check >/dev/null || refuse "The backup's settings aren't in the form backup writes."
    backup_project=$(value_in COMPOSE_PROJECT_NAME "$backup_env")
    backup_project=${backup_project:-trioditis}
    if [ "$fresh" = 1 ]; then
      printf '%s\n' "$backup_project" | grep -qxE '[a-z0-9][a-z0-9_-]*' || refuse "The backup's project name isn't one an install uses."
      project=$backup_project
      # A checkout with no install has no way to stop, or back up, another checkout's server of
      # the same project on this Docker, so if that project has anything here (a volume, or a
      # container, running or not), the restore is that install's to do, from its own checkout.
      # Docker's inventory must be readable: a failed read isn't an empty one. Every name the
      # backup's volumes would take is checked again, labels or not, once the manifest is read.
      docker_volumes=$(docker volume ls -q) || refuse "Couldn't read Docker's volumes, so can't check nothing would be overwritten."
      labelled=$(docker ps -aq --filter "label=com.docker.compose.project=$project") ||
        refuse "Couldn't read Docker's containers, so can't check nothing would be overwritten."
      project_volumes_here=$(docker volume ls -q --filter "label=com.docker.compose.project=$project") ||
        refuse "Couldn't read Docker's volumes, so can't check nothing would be overwritten."
      foreign=$labelled
      for volume in $project_volumes_here; do resumed_volume "$volume" || foreign="$foreign $volume"; done
      [ -z "$foreign" ] ||
        refuse "Project $project already has volumes or containers on this Docker, from another checkout. Restore it from that checkout (deploy/trioditis restore there backs it up first), or remove that install first."
    else
      [ "$backup_project" = "$project" ] || refuse "The backup is of project $backup_project, and this install is $project."
    fi
    # The server's keys must be the ones the backup's sealed data was sealed to: the backup
    # holds only their public halves, and they open its sends, login input and agent grants.
    for pair in BRIDGE AGENT_ACCESS; do
      expected=$(value_in "${pair}_PUBLIC_KEY" "$backup_env")
      [ -n "$expected" ] || refuse "The backup's settings have no ${pair}_PUBLIC_KEY."
      if [ "$fresh" = 1 ]; then
        [ "$(value_in "${pair}_PUBLIC_KEY" "$key_file_text")" = "$expected" ] ||
          refuse "$key_file's ${pair} keys aren't those of the server the backup is from."
      else
        [ "$(value_in "${pair}_PUBLIC_KEY" "$env_text")" = "$expected" ] ||
          refuse "This install's ${pair} key isn't the one the backup's data is sealed to: restore it on the server it's from, or onto a new checkout with --keys <that server's key file>."
        valid_key "$(value_in "${pair}_PRIVATE_KEY" "$env_text")" ||
          refuse "deploy/.env has no ${pair}_PRIVATE_KEY: import the keys first (deploy/trioditis keys import <file>)."
      fi
    done
    # And each private key must be that public key's private half, derived here (no key is
    # printed), not taken on trust from deploy/.env. (A key file's were derived when it was read.)
    if [ "$fresh" = 0 ]; then
      derived=$(for pair in BRIDGE AGENT_ACCESS; do
        printf '%s %s\n' "$pair" "$(value_in "${pair}_PRIVATE_KEY" "$env_text")"
      done | derive_public_keys) || refuse "Couldn't check the server's keys."
      for pair in BRIDGE AGENT_ACCESS; do
        [ "$(printf '%s\n' "$derived" | sed -n "s/^$pair //p")" = "$(value_in "${pair}_PUBLIC_KEY" "$backup_env")" ] ||
          refuse "deploy/.env's ${pair}_PRIVATE_KEY isn't the private half of the public key the backup's data is sealed to."
      done
    fi
    # The same version as this checkout, whose functions and schema the data was written by;
    # one this version descends from only when asked (its migrations then move the data
    # forward); never a newer one, which this version's schema may not read.
    backup_version=$(value_in TRIODITIS_VERSION "$backup_env")
    checkout_version=$(git -C "$here/.." rev-parse --verify --quiet 'HEAD^{commit}' 2>/dev/null || true)
    [ -n "$checkout_version" ] || refuse "Can't tell which version this checkout is (it isn't a git checkout), so can't check the backup is from it."
    if [ "$backup_version" != "$checkout_version" ]; then
      if [ "$older" = 1 ] && printf '%s\n' "$backup_version" | grep -qxE '[0-9a-f]{40}' &&
        git -C "$here/.." merge-base --is-ancestor "$backup_version" "$checkout_version" 2>/dev/null; then
        echo "warning: the backup is from ${backup_version%"${backup_version#???????}"}, older than this checkout (${checkout_version%"${checkout_version#???????}"}): the installer runs this version's migrations on its data." >&2
      else
        refuse "The backup is from version ${backup_version:-unknown}, and this checkout is at $checkout_version. Check that version out first (git -C $(cd "$here/.." && pwd) checkout ${backup_version:-<version>}) and restore there, then update. A backup from a version this one descends from can be restored here with --from-older-version."
      fi
    fi

    # Then the archive, read whole before anything stops: it must open with this key (each
    # chunk is authenticated, so a damaged or cut-short one fails), its manifest says what it
    # holds, and every entry must belong to one of the volumes the manifest lists.
    # shellcheck disable=SC2016 # expanded in the container
    manifest_text=$( { stream "$source_dir"; echo "$?" >"$work/read"; } |
      docker run --rm -i --sig-proxy=false --log-driver none --entrypoint sh "$tool" -c \
        'mkdir /out && tar -xf - -C /out "./$1" && cat "/out/$1"' sh "$manifest") && [ "$(cat "$work/read")" = 0 ] ||
      refuse "Couldn't read the backup's archive: it's damaged, cut short, or not this install's."
    printf '%s\n' "$manifest_text" | head -1 | grep -qxE 'trioditis-backup [12]' || refuse "The backup's archive has no manifest backup wrote."
    volumes=$(printf '%s\n' "$manifest_text" | sed -n 's/^volume \([^ ]*\) [0-9]* [0-9]*$/\1/p')
    [ -n "$volumes" ] || refuse "The backup's manifest lists no volumes."
    for volume in $volumes; do
      case "$volume" in "${project}_"*) ;; *) refuse "The backup holds volume $volume, which isn't this install's." ;; esac
      printf '%s\n' "$volume" | grep -qxE '[A-Za-z0-9][A-Za-z0-9_.-]*' || refuse "The backup's manifest names a volume oddly ($volume)."
      # With no install, a volume of that name already here (labelled by Compose or not) isn't
      # this restore's to empty.
      [ "$fresh" = 0 ] || ! printf '%s\n' "$docker_volumes" | grep -qxF "$volume" || resumed_volume "$volume" ||
        refuse "A volume named $volume is already on this Docker. Restore from the checkout it belongs to, or remove it first."
    done
    # shellcheck disable=SC2016 # expanded in the container
    stray=$( { stream "$source_dir"; echo "$?" >"$work/read"; } |
      docker run --rm -i --sig-proxy=false --log-driver none -e VOLUMES="$volumes" -e MANIFEST="$manifest" \
        --entrypoint sh "$tool" -c 'tar -tf - | awk -v volumes="$VOLUMES" -v manifest="./$MANIFEST" "
          BEGIN { n = split(volumes, list, \" \"); for (i = 1; i <= n; i++) known[\"./\" list[i]] = 1 }
          { name = \$0; sub(/\/\$/, \"\", name) }
          name == manifest { next }
          name ~ /(^|\/)\.\.(\/|\$)/ { bad++; next }
          { top = name; if (match(name, /^\.\/[^\/]+/)) top = substr(name, 1, RLENGTH); if (!(top in known)) bad++ }
          END { print bad + 0 }"') && [ "$(cat "$work/read")" = 0 ] ||
      refuse "Couldn't read the backup's archive: it's damaged, cut short, or not this install's."
    [ "$stray" = 0 ] || refuse "The backup's archive holds $stray entries outside the volumes it lists."
    # When its data stopped changing, in milliseconds, for settling the sends it holds: from the
    # manifest, or, for an older backup without that, a day before its archive was written (too
    # early only ever leaves a send unknown rather than failed).
    created=$(printf '%s\n' "$manifest_text" | sed -n 's/^created \([0-9][0-9]*\)$/\1/p')
    [ -n "$created" ] || created=$(($(stat -c %Y "$source_dir/archive.tgz" 2>/dev/null || date +%s) - 86400))
    backup_at=$((created * 1000))
    # Postgres opens only data from its own major version, and the bundle doesn't upgrade it in
    # place, so a backup from another stops here rather than once its data has replaced this.
    # The archive's own record of what it is must agree with backup.info and the settings: the
    # same backup, from the same version.
    manifest_id=$(printf '%s\n' "$manifest_text" | sed -n 's/^id //p')
    [ "$manifest_id" = "$id" ] || refuse "The backup's archive isn't the one its backup.info names."
    manifest_version=$(printf '%s\n' "$manifest_text" | sed -n 's/^version //p')
    [ -z "$manifest_version" ] || [ "$manifest_version" = "${backup_version:-unknown}" ] ||
      refuse "The backup's archive is from version $manifest_version, and its settings from ${backup_version:-unknown}."
    backup_pg=$(printf '%s\n' "$manifest_text" | sed -n 's/^postgres \([0-9][0-9]*\)$/\1/p')
    # A manifest from before it recorded the Postgres version: read it from the archived data.
    if [ -z "$backup_pg" ] && printf '%s\n' "$volumes" | grep -qxF "${project}_postgres"; then
      # shellcheck disable=SC2016 # expanded in the container
      backup_pg=$( { stream "$source_dir"; echo "$?" >"$work/read"; } |
        docker run --rm -i --sig-proxy=false --log-driver none --entrypoint sh "$tool" -c \
          'tar -xOf - "./$1/PG_VERSION"' sh "${project}_postgres") && [ "$(cat "$work/read")" = 0 ] &&
        printf '%s\n' "$backup_pg" | grep -qxE '[0-9]+' ||
        refuse "Couldn't read which Postgres version the backup's database is from."
    fi
    bundle_pg=$(sed -n 's/^ *image: postgres:\([0-9][0-9]*\)[.-].*/\1/p' "$here/compose/compose.yml" | head -1)
    [ -z "$backup_pg" ] || [ -z "$bundle_pg" ] || [ "$backup_pg" = "$bundle_pg" ] ||
      refuse "The backup's database is from Postgres $backup_pg, and this version runs Postgres $bundle_pg, which can't open it."

    if [ "$assume_yes" != 1 ]; then
      [ -t 0 ] || { echo "Restore replaces the server's data and settings, so it asks first: run it in a terminal, or pass --yes." >&2; exit 2; }
      echo "This replaces project $project's data and settings with the backup's, from $(date -d "@$created" '+%Y-%m-%d %H:%M' 2>/dev/null || echo "$created")."
      [ "$fresh" = 1 ] || echo "The server as it is now is backed up first, to ${recovery_parent:-$(dirname "$source_dir")}."
      printf 'Type yes to go on: '
      read -r answer
      [ "$answer" = yes ] || refuse "Not restored."
    fi

    # The server stops, and a copy of it as it is now is made and checked by backup itself, so
    # nothing it does after this is lost from that copy. If that fails, the containers that
    # were running start again and nothing has changed. With no install there's nothing to keep.
    recovery=''
    if [ "$fresh" = 0 ]; then
      recovery_parent=${recovery_parent:-$(dirname "$source_dir")}
      was_running=$(docker ps -q --filter "label=com.docker.compose.project=$project")
      compose stop || refuse "Couldn't stop the server."
      echo "Backing up the server as it is now, so it can be put back: $recovery_parent"
      if ! recovery_out=$("$here/trioditis" backup "$recovery_parent" 2>&1) ||
        ! recovery=$(printf '%s\n' "$recovery_out" | sed -n 's/^Backed up project [^ ]* to \(.*\) (archive\.enc.*/\1/p') ||
        [ ! -d "$recovery" ]; then
        printf '%s\n' "$recovery_out" >&2
        # shellcheck disable=SC2086 # one ID per word
        [ -z "$was_running" ] || docker start $was_running >/dev/null || echo "Start the server again with deploy/trioditis up -d." >&2
        refuse "Couldn't back up the server as it is now (above), so it wasn't restored."
      fi
    fi

    # From here the data changes, so interrupts are held off until it and the settings are
    # whole. Until the installer has settled the restored sends, the gateway can't start,
    # whatever stops this partway: deploy/.restore-settle is there, which deploy/trioditis
    # refuses to start anything beside; RESTORE_PENDING is in deploy/.env, which Compose hands
    # the gateway, which then refuses to start (apps/gateway/src/config.ts); and the gateway's
    # container is gone, so nothing can start it again as it was.
    # The marker says how far the restore got: `loading` while the volumes and settings are
    # being replaced, which the installer refuses to start anything on (the data may be half one
    # and half the other); `ready` once both are the backup's and checked, which it settles.
    trap '' INT TERM HUP
    write_marker() {
      marker_tmp=$(mktemp "$here/.restore-settle.XXXXXX") &&
        printf 'state=%s\nbackup_at=%s\nrestore_id=%s\nbackup_id=%s\nfresh=%s\n' "$1" "$backup_at" "$restore_id" "$backup_key_id" "$fresh" >"$marker_tmp" &&
        mv -f "$marker_tmp" "$here/.restore-settle" ||
        { rm -f "$marker_tmp"; echo "Couldn't write deploy/.restore-settle." >&2; return 1; }
    }
    # Written before any volume is made, so a run cut off after making some carries on from them.
    write_marker loading || refuse "The restore couldn't mark itself as under way."
    if [ "$fresh" = 0 ]; then
      { printf '%s\n' "$env_text" | grep -vE '^(RESTORE_PENDING|RESTORE_ID)=' || true
        echo "RESTORE_PENDING=$backup_at"; echo "RESTORE_ID=$restore_id"; } |
        sed '/^$/d' | env_write "$env_file" || { echo "Couldn't mark deploy/.env as restoring." >&2; exit 1; }
      # The gateway's container and every bridge host's go, those of networks no longer enabled
      # included: each was made with the settings from before, and a bridge host started again
      # as it was wouldn't know this restore's ID, so would run its restored queue. Whatever
      # makes them again makes them from deploy/.env as it is now. Checked with Docker, not taken
      # on trust.
      stale=$(docker ps -a --filter "label=com.docker.compose.project=$project" --format '{{.ID}} {{.Label "com.docker.compose.service"}}' |
        awk '$2 == "gateway" || $2 ~ /^bridge-/ { print $1 }') || true
      # shellcheck disable=SC2086 # one ID per word
      [ -z "$stale" ] || docker rm -f $stale >/dev/null 2>&1 || true
      remaining=$(docker ps -a --filter "label=com.docker.compose.project=$project" --format '{{.Label "com.docker.compose.service"}}') ||
        { echo "Couldn't list the server's containers. The data wasn't touched; run the restore again." >&2; exit 1; }
      left=$(printf '%s\n' "$remaining" | grep -xE 'gateway|bridge-.*') || left=''
      [ -z "$left" ] || { echo "Couldn't remove the containers of: $(echo $left). The data wasn't touched; run the restore again." >&2; exit 1; }
    fi
    # load DIR VOLUMES MANIFEST: empties each volume and fills it from DIR's archive, then
    # checks every one against the manifest's count of entries and bytes.
    load() {
      for volume in $2; do
        # A volume it makes carries this restore's ID. Docker's create succeeds on a name that's
        # taken, so with no install what's checked is the label, after: a volume someone else made
        # meanwhile (or ever) isn't this restore's to empty.
        docker volume inspect "$volume" >/dev/null 2>&1 ||
          docker volume create --label "com.docker.compose.project=$project" \
            --label "com.docker.compose.volume=${volume#"${project}_"}" --label "trioditis.restore=$restore_id" "$volume" >/dev/null || return 1
        if [ "$fresh" = 1 ] && [ "$(restore_label "$volume")" != "$restore_id" ]; then
          echo "The volume $volume on this Docker isn't one this restore made; it's left as it is." >&2
          return 1
        fi
      done
      mounts=''
      for volume in $2; do mounts="$mounts -v $volume:/volumes/$volume"; done
      want=$(printf '%s\n' "$3" | grep '^volume ' | sort)
      # shellcheck disable=SC2016,SC2086 # expanded in the container; $mounts is a list of -v options
      got=$( { stream "$1"; echo "$?" >"$work/load"; } |
        docker run --rm -i --sig-proxy=false --log-driver none $mounts -e VOLUMES="$2" --entrypoint sh "$tool" -c '
          set -e
          umask 000
          cd /volumes
          for volume in $VOLUMES; do find "./$volume" -mindepth 1 -delete; done
          tar -xf -
          for volume in $VOLUMES; do
            entries=$(find "./$volume" | wc -l)
            bytes=$(find "./$volume" -type f -exec stat -c %s {} + | awk "{ s += \$1 } END { print s + 0 }")
            echo "volume $volume $entries $bytes"
          done' | sort) || return 1
      [ "$(cat "$work/load")" = 0 ] || return 1
      [ "$got" = "$want" ] || { echo "The restored volumes don't match the backup's manifest." >&2; return 1; }
    }
    # shellcheck disable=SC2086 # one volume per word, on one line
    echo "Restoring the volumes: $(echo $volumes)"
    if ! load "$source_dir" "$volumes" "$manifest_text"; then
      # The gate stays until the copy from before is back and checked.
      [ -n "$recovery" ] || { echo "Restoring the volumes failed partway (above). Run the restore again." >&2; exit 1; }
      echo "Restoring the volumes failed partway (above); putting back the server as it was, from $recovery." >&2
      encrypted=1
      backup_key=$(value_in BACKUP_KEY "$env_text")
      back_manifest=$( { stream "$recovery"; echo "$?" >"$work/read"; } |
        docker run --rm -i --sig-proxy=false --log-driver none --entrypoint sh "$tool" -c \
          'mkdir /out && tar -xf - -C /out "./$1" && cat "/out/$1"' sh "$manifest") && [ "$(cat "$work/read")" = 0 ] &&
        back_volumes=$(printf '%s\n' "$back_manifest" | sed -n 's/^volume \([^ ]*\) [0-9]* [0-9]*$/\1/p') &&
        load "$recovery" "$back_volumes" "$back_manifest" ||
        { echo "Putting it back failed too: deploy/trioditis restore $recovery tries again. Until then nothing that sends starts." >&2; exit 1; }
      # The data is as it was when the server stopped for this restore, so there's nothing to
      # settle: the gate comes off, and deploy/.env goes back as it was.
      printf '%s\n' "$env_text" | env_write "$env_file" || { echo "Couldn't put deploy/.env back as it was." >&2; exit 1; }
      rm -f "$here/.restore-settle"
      "$here/install/install.sh" --no-setup-link || echo "The server as it was is back, but didn't start (above): run deploy/install/install.sh." >&2
      echo "Nothing was restored: the server is as it was." >&2
      exit 1
    fi
    # The settings: the backup's, with this server's keys (the backup has only the public
    # halves, the same ones) and any setting the operator added by hand, which backups leave out.
    if [ "$fresh" = 1 ]; then keys_from=$key_file_text; else keys_from=$env_text; fi
    # RESTORE_PENDING stays set, for the installer to clear once it has settled the sends.
    new_text=$(printf '%s\n' "$backup_env" | grep -vE "^($private_keys|RESTORE_PENDING|RESTORE_ID)=" || true)
    new_text="$new_text
RESTORE_PENDING=$backup_at
RESTORE_ID=$restore_id"
    for name in BRIDGE_PRIVATE_KEY AGENT_ACCESS_PRIVATE_KEY BACKUP_KEY; do
      value=$(value_in "$name" "$keys_from")
      [ -z "$value" ] || new_text="$new_text
$name=$value"
    done
    for name in $(printf '%s\n' "$env_text" | env_names); do
      case "$name" in BRIDGE_PRIVATE_KEY | AGENT_ACCESS_PRIVATE_KEY | BACKUP_KEY) continue ;; esac
      ! grep -qxF "$name" "$env_names_file" || continue
      new_text="$new_text
$name=$(value_in "$name" "$env_text")"
    done
    printf '%s\n' "$new_text" | sed '/^$/d' | env_write "$env_file" || {
      echo "Couldn't write the backup's settings to deploy/.env (above). The volumes are the backup's: fix that and run the restore again." >&2
      exit 1
    }
    env_source=$env_file
    # Volumes and settings are the backup's and checked: the installer may settle and start.
    write_marker ready || { echo "Run the restore again." >&2; exit 1; }
    trap 'exit 130' INT TERM HUP

    # The installer starts the server: it builds this version's images, settles the restored
    # sends before the gateway starts, and checks everything is healthy.
    echo "Starting the restored server"
    if ! "$here/install/install.sh" --no-setup-link; then
      echo "The data and settings are the backup's, but the server didn't start (above). Fix the cause and run deploy/install/install.sh, which settles the restored sends before it starts anything that sends." >&2
      [ -z "$recovery" ] || echo "To go back to the server as it was: deploy/trioditis restore $recovery" >&2
      exit 1
    fi
    echo "Restored project $project from $source_dir."
    echo "Sends that were on their way when the backup was taken are marked unknown, not sent again: each person sees them and decides."
    [ -z "$recovery" ] || echo "The server as it was before is backed up in $recovery."
    ;;
  keys)
    case "${2:-}" in export | import) ;; *) echo "Usage: deploy/trioditis keys export|import <file>" >&2; exit 2 ;; esac
    [ $# -eq 3 ] || { echo "Usage: deploy/trioditis keys $2 <file>" >&2; exit 2; }
    # deploy/.env, read once (after taking the lock, for an import, which writes it). No key is
    # ever printed.
    [ "$2" != import ] || take_lock
    read_env
    if [ "$2" = export ]; then
      # A new file, readable only by you, published with a rename that fails if anything is
      # at the name, so nothing is ever overwritten; never inside the checkout.
      dir=$(cd "$(dirname "$3")" && pwd -P) || { echo "No directory for $3." >&2; exit 1; }
      case "$dir/" in
        "$(cd "$here/.." && pwd -P)"/*) echo "Keep the keys outside the checkout: image builds copy it." >&2; exit 2 ;;
      esac
      file="$dir/$(basename "$3")"
      umask 077
      text="# Trioditis server keys for project $project. Keep this apart from the backups."
      for name in $key_names; do
        value=$(value_in "$name" "$env_text")
        [ -n "$value" ] || { echo "deploy/.env has no $name, so there's no complete set of keys to export. Run deploy/install/install.sh, which makes the missing ones, then export them again." >&2; exit 1; }
        text="$text
$name=$value"
      done
      tmp=$(mktemp "$dir/.trioditis-keys-XXXXXX")
      trap 'rm -f "$tmp"' EXIT
      printf '%s\n' "$text" >"$tmp"
      # A hard link, which fails if anything is at the name (and doesn't depend on mv's
      # no-clobber behaviour, which differs between versions).
      if ! ln -T "$tmp" "$file" 2>/dev/null; then
        if [ -e "$file" ] || [ -L "$file" ]; then echo "$file already exists and was left as it is; pick another name." >&2; else echo "Couldn't write $file." >&2; fi
        exit 1
      fi
      echo "Wrote the server's keys to $file, readable only by you. Keep it apart from the backups (a password manager, or offline media)."
    else
      # Each pair must be this server's: its public half must be the public key deploy/.env
      # already has (from the backup's secrets.env, after a lost server). The private keys are
      # added through a temp file and a rename onto deploy/.env.
      check_key_file "$3" "$env_text" "deploy/.env" "put the backup's secrets.env back as deploy/.env first"
      new_text=$(printf '%s\n' "$env_text" | grep -vE "^($private_keys)=" || true)
      for pair in BRIDGE AGENT_ACCESS; do
        private=$(value_in "${pair}_PRIVATE_KEY" "$key_file_text")
        existing=$(value_in "${pair}_PRIVATE_KEY" "$env_text")
        [ -z "$existing" ] || [ "$existing" = "$private" ] ||
          { echo "deploy/.env already has a different ${pair}_PRIVATE_KEY. Nothing was changed." >&2; exit 1; }
        new_text="$new_text
${pair}_PRIVATE_KEY=$private"
      done
      # The backup key, from a key file that has it (one exported before backups were
      # encrypted doesn't); otherwise deploy/.env's own stays.
      file_backup=$(value_in BACKUP_KEY "$key_file_text")
      existing=$(value_in BACKUP_KEY "$env_text")
      [ -z "$file_backup" ] || [ -z "$existing" ] || [ "$existing" = "$file_backup" ] ||
        { echo "deploy/.env already has a different BACKUP_KEY. Nothing was changed." >&2; exit 1; }
      backup_key=${file_backup:-$existing}
      [ -z "$backup_key" ] || new_text="$new_text
BACKUP_KEY=$backup_key"
      printf '%s\n' "$new_text" | sed '/^$/d' | env_write "$env_file" || { echo "Nothing was changed." >&2; exit 1; }
      echo "Imported the server's private keys into deploy/.env. Run deploy/install/install.sh to start the server."
    fi
    ;;
  create-admin)
    [ $# -eq 2 ] || { echo "Usage: deploy/trioditis create-admin <email>" >&2; exit 2; }
    take_lock
    [ -t 0 ] || { echo "create-admin asks for the password, so run it in a terminal." >&2; exit 2; }
    # Asked here without echo (back on however it ends) and handed to the container by name,
    # so it's never an argument.
    trap 'stty echo 2>/dev/null || true' EXIT
    stty -echo
    printf 'Password for %s: ' "$2"
    read -r TRIODITIS_ADMIN_PASSWORD
    printf '\nAgain: '
    read -r again
    stty echo
    printf '\n'
    [ "$TRIODITIS_ADMIN_PASSWORD" = "$again" ] || { echo "The passwords don't match." >&2; exit 1; }
    export TRIODITIS_ADMIN_PASSWORD
    compose run --rm --no-deps -T -e TRIODITIS_ADMIN_PASSWORD --entrypoint node functions \
      deploy/scripts/create-admin.ts "$2"
    ;;
  *)
    # `deploy/trioditis <command> [its options and arguments]`: the project, the compose
    # files, the project directory and the env file are this install's, set here, so nothing
    # may come before the command (no Compose global options at all), and only Compose's own
    # commands are passed on. Those that change nothing run beside a backup or install;
    # every other one takes the lock first and holds it while it runs.
    case "${1:-}" in
      '') echo "Usage: deploy/trioditis <compose command> [options], e.g. ps, logs -f gateway, restart caddy" >&2 && exit 2 ;;
      -*) echo "deploy/trioditis takes no options before the command ($1): it sets the project, files and settings itself." >&2 && exit 2 ;;
      config)
        # config shows the settings (secrets included) on the terminal; it never writes them
        # to a file, where they'd land readable, and unlocked.
        for arg in "$@"; do
          case "$arg" in
            -o* | --output | --output=* | -[!-]*o*)
              echo "deploy/trioditis config doesn't write a file ($arg): the output holds the server's secrets." >&2
              exit 2
              ;;
          esac
        done
        ;;
      ps | logs | top | images | ls | port | version | events) ;;
      # Those that may start something run only with a deploy/.env in the one form, so a
      # setting the installer would refuse (LOGIN_BROWSER_MAX=lots, say) never reaches Compose.
      up | down | start | stop | restart | run | exec | rm | create | kill | pause | unpause | pull | build | cp | attach | wait | watch | scale | stats)
        take_lock
        check_env_text
        # Until the installer has settled a restore's sends, nothing that could start the
        # gateway (or anything waiting on it) runs: a send the backup held may have gone already.
        case "$1" in
          up | start | restart | run | create | unpause | watch | scale)
            if [ -e "$here/.restore-settle" ] || [ -n "$(value_in RESTORE_PENDING "$env_text")" ]; then
              echo "A restore's sends aren't settled yet, so deploy/trioditis $1 won't start anything: run deploy/install/install.sh, which settles them first." >&2
              exit 1
            fi
            ;;
        esac
        ;;
      *) echo "deploy/trioditis doesn't know the command $1." >&2 && exit 2 ;;
    esac
    cd "$here/compose"
    exec docker compose --env-file "$env_file" -p "$project" "$@"
    ;;
esac
