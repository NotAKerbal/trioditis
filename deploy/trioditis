#!/bin/sh
# `docker compose` for this install, with its settings. Usage: deploy/trioditis <compose args>
# e.g. `deploy/trioditis ps`, `deploy/trioditis logs -f gateway`, `deploy/trioditis down`.
# Also `deploy/trioditis backup <dir>`, `deploy/trioditis keys export|import <file>` and
# `deploy/trioditis create-admin <email>`: see docs/deploy.md. (`restore` comes in a later
# version.)
#
# What backup guards against (docs/deploy.md, Backup): the operator's mistakes, a second
# trioditis command at the same time, other Compose projects on the same Docker, interrupts,
# full disks and read-only filesystems, and steps that fail partway. The checkout and the
# backup directory are writable only by the operator, so not against a hostile process
# running as the same user that rewrites paths while a command runs.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
env_file="$here/.env"
if [ ! -f "$env_file" ]; then
  echo "No install here yet. Run deploy/install/install.sh first." >&2
  exit 1
fi
# The project is the one this install saved (installs from before it was saved use the
# default), whatever COMPOSE_PROJECT_NAME says: it names the volumes that hold the data.
project=$(grep -E '^COMPOSE_PROJECT_NAME=' "$env_file" | tail -1 | cut -d= -f2-)
project=${project:-trioditis}
# deploy/.env is the only source of the install's settings and secrets, so every variable it
# sets, every one the compose files read, and every COMPOSE_* one (Compose's own settings,
# found in the environment, since new ones appear) are dropped here: an exported one
# would override the file, and the running stack would no longer match the .env a backup
# saves. Compose reads COMPOSE_FILE and COMPOSE_PROFILES from .env relative to where it runs,
# so it runs in the compose directory; this script stays where it was called, so paths given
# to it mean what they say.
for name in $( {
  sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$env_file"
  grep -ohE '\$\{[A-Za-z_][A-Za-z0-9_]*' "$here"/compose/*.yml | cut -c3-
  env | sed -n 's/^\(COMPOSE_[A-Za-z0-9_]*\)=.*/\1/p'
} | sort -u); do
  unset "$name"
done
compose() { (cd "$here/compose" && docker compose --env-file "$env_file" -p "$project" "$@"); }

# The archive tool: the bundle's pinned Alpine-based image, which has tar and gzip.
tool=alpine/socat:1.8.0.3@sha256:beb4a68d9e4fe6b0f21ea774a0fde6c31f580dde6368939ed70100c5385b015e
# Written last into every archive, so an archive cut short anywhere has none. It lists each
# volume with its number of entries and bytes, for a restore to check its extraction against.
manifest=trioditis-backup.manifest

# An interrupted command exits, so its EXIT cleanup runs too.
trap 'exit 130' INT TERM HUP

# Every volume of this project, found by the label Compose gives them, so a dropped network's
# volume is included and another install's never is.
project_volumes() {
  docker volume ls -q --filter "label=com.docker.compose.project=$project" | sort
}

# One backup, install or other write command for this install at a time: they stop and
# start the server under each other. install.sh takes the same lock.
take_lock() {
  command -v flock >/dev/null || { echo "This command needs flock (util-linux)." >&2; exit 1; }
  exec 9>"$here/.operation.lock"
  flock -n 9 || { echo "Another backup, install or change to this install is running." >&2; exit 1; }
}

random_hex() { od -An -N8 -tx1 /dev/urandom | tr -d ' \n'; }

# Prints, and fails on, each line of deploy/.env (on stdin) not in the form the installer
# writes: NAME=value, the value unquoted, each name once (comments and blank lines aside).
# Anything else Compose also reads (`export NAME=…`, spaces around `=`, a quoted value that
# could run over lines), and backup could only leave the private keys out of NAME=value lines.
env_noncanonical() {
  awk '
    /^[[:space:]]*$/ || /^#/ { next }
    !/^[A-Za-z_][A-Za-z0-9_]*=/ { print "line " NR " isn'"'"'t NAME=value"; bad = 1; next }
    {
      name = $0; sub(/=.*/, "", name)
      value = $0; sub(/^[^=]*=/, "", value)
      if (value ~ /^["\047`]/) { print "line " NR " (" name ") has a quoted value"; bad = 1 }
      if (seen[name]++) { print "line " NR " sets " name " again"; bad = 1 }
    }
    END { exit bad }'
}

# The bundle's Node image (as in deploy/docker/node.Dockerfile), for deriving public keys.
node_image=node:24.21-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20
# Reads "<name> <X25519 private key, base64url>" lines on stdin and prints "<name> <its public
# key>" for each, in a container with no network that logs nothing: the keys never become
# arguments or reach a log.
derive_public_keys() {
  docker image inspect "$node_image" >/dev/null 2>&1 || docker pull -q "$node_image" >/dev/null
  docker run --rm -i --network none --log-driver none "$node_image" node -e "
    const { createPrivateKey, createPublicKey } = require('node:crypto')
    let input = ''
    process.stdin.on('data', (data) => (input += data)).on('end', () => {
      for (const line of input.split('\\n').filter(Boolean)) {
        const [name, privateKey] = line.split(' ')
        const raw = Buffer.from(privateKey, 'base64url')
        if (raw.length !== 32) { console.log(name + ' invalid'); continue }
        const pkcs8 = Buffer.concat([Buffer.from('302e020100300506032b656e04220420', 'hex'), raw])
        const spki = createPublicKey(createPrivateKey({ key: pkcs8, format: 'der', type: 'pkcs8' }))
          .export({ format: 'der', type: 'spki' })
        console.log(name + ' ' + spki.subarray(-32).toString('base64url'))
      }
    })"
}

# The server's private keys, which open what's sealed to it: the bridge key (sends and login
# input) and the agent-access key (granted chats). Backups leave them out; `keys` moves them.
private_keys='BRIDGE_PRIVATE_KEY|AGENT_ACCESS_PRIVATE_KEY'
key_names='BRIDGE_PUBLIC_KEY BRIDGE_PRIVATE_KEY AGENT_ACCESS_PUBLIC_KEY AGENT_ACCESS_PRIVATE_KEY'
# The last value of $1 in text $2.
value_in() { printf '%s\n' "$2" | sed -n "s/^$1=//p" | tail -1; }

case "${1:-}" in
  backup)
    [ $# -eq 2 ] || { echo "Usage: deploy/trioditis backup <directory outside the checkout>" >&2; exit 2; }
    mkdir -p "$2"
    # Real paths, so a symlink can't lead the backup into the checkout.
    dir=$(cd "$2" && pwd -P)
    case "$dir/" in
      "$(cd "$here/.." && pwd -P)"/*) echo "Back up outside the checkout: image builds copy it." >&2; exit 2 ;;
    esac
    take_lock
    if ! problems=$(env_noncanonical <"$env_file"); then
      echo "deploy/.env isn't all in the form the installer writes (NAME=value), so the backup can't be sure it leaves the private keys out:" >&2
      echo "$problems" | sed 's/^/  /' >&2
      echo "Fix those lines (or run the installer, which keeps the file that way) and back up again." >&2
      exit 1
    fi
    # Everything the backup writes is the caller's alone.
    umask 077
    worker="$project-backup-$(random_hex)"
    # A backup is a directory holding the archive and the .env. It's assembled in a new
    # private directory beside where it goes, and published with one rename that fails if
    # anything is at the name, so there's either a whole backup there or none, and nothing
    # already there is ever replaced. Until then cleanup only ever touches this directory.
    work=$(mktemp -d "$dir/.$project-backup-XXXXXX")
    published=''
    reserved=''
    running=''
    # However it ends, even interrupted while stopping: the archive container goes first, so
    # nothing still reads the volumes; the unpublished directory goes; and what was running
    # starts again once any stop still under way in Docker has finished. A second interrupt
    # can't cut this short, no step's failure skips the next, and a server that doesn't start
    # again makes the backup a failure.
    finish_backup() {
      status=$?
      trap '' INT TERM HUP
      docker rm -f "$worker" >/dev/null 2>&1 || true
      [ -z "$work" ] || rm -rf "$work" || true
      # A name reserved but never published: only the empty directory this backup made.
      [ -z "$reserved" ] || rmdir "$reserved" 2>/dev/null || true
      if [ -n "$running" ]; then
        compose stop >/dev/null 2>&1 || true
        # shellcheck disable=SC2086 # $running is a list of services
        if ! compose start $running >/dev/null 2>&1; then
          echo "The server didn't start again after the backup: run deploy/trioditis up -d." >&2
          status=1
        fi
      fi
      if [ "$status" = 0 ]; then
        echo "Backed up project $project to $published (archive.tgz, and the secrets in secrets.env)."
        echo "It holds private data: keep it encrypted."
        echo "The server's private keys aren't in it: with a backup they'd open what's sealed to the server."
        echo "Keep them apart from your backups (a password manager, or offline media): deploy/trioditis keys export <file>."
      else
        echo "The backup failed." >&2
      fi
      exit "$status"
    }
    trap finish_backup EXIT
    # One service per line; empty if none is running, so a cold backup starts nothing.
    running=$(compose ps --services --status running)

    volumes=$(project_volumes)
    [ -n "$volumes" ] || { echo "No volumes for project $project." >&2; exit 1; }
    # Stopped, so the databases are consistent.
    compose stop
    mounts=''
    members=''
    for volume in $volumes; do
      mounts="$mounts -v $volume:/volumes/$volume:ro"
      members="$members ./$volume"
    done
    # With --init the container gets an interrupt, and tar runs in the background so the
    # shell's trap stops it straight away.
    # shellcheck disable=SC2086 # $mounts is a list of -v options
    docker run --rm --init --name "$worker" --log-driver none $mounts \
      -e MEMBERS="$members" -e MANIFEST="$manifest" \
      --entrypoint sh "$tool" -c '
        trap "kill \$tar_pid 2>/dev/null; exit 130" INT TERM
        cd /volumes
        {
          echo "trioditis-backup 1"
          for volume in $MEMBERS; do
            entries=$(find "$volume" | wc -l)
            bytes=$(find "$volume" -type f -exec stat -c %s {} + | awk "{ s += \$1 } END { print s + 0 }")
            echo "volume ${volume#./} $entries $bytes"
          done
        } >"$MANIFEST"
        tar -czf - $MEMBERS "./$MANIFEST" & tar_pid=$!
        wait "$tar_pid"' >"$work/archive.tgz"
    # deploy/.env without the private keys, read in one pass: a backup holds sealed content, and
    # those keys open it (docs/architecture/sealing.md, Bridge key exposure).
    read_status=0
    grep -vE "^($private_keys)=" "$env_file" >"$work/secrets.env" || read_status=$?
    [ "$read_status" -le 1 ] || { echo "Couldn't read deploy/.env." >&2; exit 1; }

    # The name is reserved with mkdir, which fails if anything (a file, a directory, a link) is
    # there; then the private directory is renamed onto that empty one in one step, so the
    # pair of files appears whole or not at all. No exit status is taken on trust: after the
    # rename, the private directory must be gone and the name must hold both files.
    stamp="$dir/$project-$(date +%Y%m%d-%H%M%S)"
    n=1
    name=$stamp
    until mkdir "$name" 2>/dev/null && reserved=$name; do
      [ -e "$name" ] || [ -L "$name" ] || { echo "Couldn't create the backup in $dir." >&2; exit 1; }
      n=$((n + 1))
      [ "$n" -le 100 ] || { echo "No free name for the backup in $dir." >&2; exit 1; }
      name="$stamp-$n"
    done
    if ! mv -T "$work" "$name" 2>/dev/null || [ -e "$work" ] || [ ! -f "$name/archive.tgz" ] || [ ! -f "$name/secrets.env" ]; then
      echo "Couldn't publish the backup in $dir." >&2
      exit 1
    fi
    work=''
    reserved=''
    published=$name
    ;;
  restore)
    # Restore comes in a later version (deploy/restore). Refused before the lock or anything
    # else, so no restore can half happen.
    echo "Restore isn't available in this version yet. Keep your backups: a later version restores them." >&2
    exit 1
    ;;
  keys)
    case "${2:-}" in export | import) ;; *) echo "Usage: deploy/trioditis keys export|import <file>" >&2; exit 2 ;; esac
    [ $# -eq 3 ] || { echo "Usage: deploy/trioditis keys $2 <file>" >&2; exit 2; }
    # deploy/.env, read once (after taking the lock, for an import, which writes it). No key is
    # ever printed.
    [ "$2" != import ] || take_lock
    { [ -f "$env_file" ] && [ ! -L "$env_file" ]; } || { echo "deploy/.env isn't a regular file." >&2; exit 1; }
    env_text=$(cat "$env_file")
    if [ "$2" = export ]; then
      # A new file, readable only by you, published with a rename that fails if anything is
      # at the name, so nothing is ever overwritten; never inside the checkout.
      dir=$(cd "$(dirname "$3")" && pwd -P) || { echo "No directory for $3." >&2; exit 1; }
      case "$dir/" in
        "$(cd "$here/.." && pwd -P)"/*) echo "Keep the keys outside the checkout: image builds copy it." >&2; exit 2 ;;
      esac
      file="$dir/$(basename "$3")"
      umask 077
      text="# Trioditis server keys for project $project. Keep this apart from the backups."
      for name in $key_names; do
        value=$(value_in "$name" "$env_text")
        [ -n "$value" ] || { echo "deploy/.env has no $name, so there's no complete set of keys to export." >&2; exit 1; }
        text="$text
$name=$value"
      done
      tmp=$(mktemp "$dir/.trioditis-keys-XXXXXX")
      trap 'rm -f "$tmp"' EXIT
      printf '%s\n' "$text" >"$tmp"
      # A hard link, which fails if anything is at the name (and doesn't depend on mv's
      # no-clobber behaviour, which differs between versions).
      if ! ln -T "$tmp" "$file" 2>/dev/null; then
        if [ -e "$file" ] || [ -L "$file" ]; then echo "$file already exists and was left as it is; pick another name." >&2; else echo "Couldn't write $file." >&2; fi
        exit 1
      fi
      echo "Wrote the server's keys to $file, readable only by you. Keep it apart from the backups (a password manager, or offline media)."
    else
      # Each pair must be this server's: its public half must be the public key deploy/.env
      # already has (from the backup's secrets.env, after a lost server). The private keys are
      # added through a temp file and a rename onto deploy/.env.
      { [ -r "$3" ] && [ ! -d "$3" ]; } || { echo "No key file at $3." >&2; exit 1; }
      file_text=$(cat "$3")
      new_text=$(printf '%s\n' "$env_text" | grep -vE "^($private_keys)=" || true)
      # Each private key's own public key, derived from it (no key is printed).
      derived=$(for pair in BRIDGE AGENT_ACCESS; do
        printf '%s %s\n' "$pair" "$(value_in "${pair}_PRIVATE_KEY" "$file_text")"
      done | derive_public_keys) || { echo "Couldn't check the keys (Docker is needed for that). Nothing was changed." >&2; exit 1; }
      for pair in BRIDGE AGENT_ACCESS; do
        public=$(value_in "${pair}_PUBLIC_KEY" "$file_text")
        private=$(value_in "${pair}_PRIVATE_KEY" "$file_text")
        { [ -n "$public" ] && [ -n "$private" ]; } || { echo "$3 has no complete ${pair} key pair. Nothing was changed." >&2; exit 1; }
        current=$(value_in "${pair}_PUBLIC_KEY" "$env_text")
        [ -n "$current" ] || { echo "deploy/.env has no ${pair}_PUBLIC_KEY: put the backup's secrets.env back as deploy/.env first. Nothing was changed." >&2; exit 1; }
        [ "$public" = "$current" ] || { echo "$3's ${pair} keys aren't this server's: the public key doesn't match deploy/.env's. Nothing was changed." >&2; exit 1; }
        [ "$(printf '%s\n' "$derived" | sed -n "s/^$pair //p")" = "$current" ] ||
          { echo "$3's ${pair}_PRIVATE_KEY isn't the private half of this server's ${pair} public key. Nothing was changed." >&2; exit 1; }
        existing=$(value_in "${pair}_PRIVATE_KEY" "$env_text")
        [ -z "$existing" ] || [ "$existing" = "$private" ] ||
          { echo "deploy/.env already has a different ${pair}_PRIVATE_KEY. Nothing was changed." >&2; exit 1; }
        new_text="$new_text
${pair}_PRIVATE_KEY=$private"
      done
      umask 077
      tmp=$(mktemp "$env_file.XXXXXX")
      trap 'rm -f "$tmp"' EXIT
      printf '%s\n' "$new_text" | sed '/^$/d' >"$tmp"
      mv -T "$tmp" "$env_file"
      echo "Imported the server's private keys into deploy/.env. Run deploy/install/install.sh to start the server."
    fi
    ;;
  create-admin)
    [ $# -eq 2 ] || { echo "Usage: deploy/trioditis create-admin <email>" >&2; exit 2; }
    take_lock
    [ -t 0 ] || { echo "create-admin asks for the password, so run it in a terminal." >&2; exit 2; }
    # Asked here without echo (back on however it ends) and handed to the container by name,
    # so it's never an argument.
    trap 'stty echo 2>/dev/null || true' EXIT
    stty -echo
    printf 'Password for %s: ' "$2"
    read -r TRIODITIS_ADMIN_PASSWORD
    printf '\nAgain: '
    read -r again
    stty echo
    printf '\n'
    [ "$TRIODITIS_ADMIN_PASSWORD" = "$again" ] || { echo "The passwords don't match." >&2; exit 1; }
    export TRIODITIS_ADMIN_PASSWORD
    compose run --rm --no-deps -T -e TRIODITIS_ADMIN_PASSWORD --entrypoint node functions \
      deploy/scripts/create-admin.ts "$2"
    ;;
  *)
    # Only commands that change nothing run beside a backup or install; anything else
    # (start, stop, up, down, run, exec…) takes the lock first and holds it while it runs. The
    # command is found past Compose's global options and their values; an option it doesn't
    # know, or no command at all, takes the lock.
    command=''
    takes_value=0
    for arg in "$@"; do
      if [ "$takes_value" = 1 ]; then takes_value=0 && continue; fi
      case "$arg" in
        -f | --file | -p | --project-name | --profile | --project-directory | --env-file | --ansi | --progress | --parallel | --workdir) takes_value=1 ;;
        --file=* | --project-name=* | --profile=* | --project-directory=* | --env-file=* | --ansi=* | --progress=* | --parallel=* | --workdir=* | -f?* | -p?*) ;;
        --compatibility | --dry-run | --all-resources | --verbose) ;;
        -*) break ;;
        *) command=$arg && break ;;
      esac
    done
    case "$command" in
      ps | logs | config | top | images | ls | port | version | events) ;;
      *) take_lock ;;
    esac
    cd "$here/compose"
    exec docker compose --env-file "$env_file" -p "$project" "$@"
    ;;
esac
