# Build context for the images in deploy/docker. Only sources go in: no installed modules,
# no local data, secrets or deployment state, and no other worktrees.
**/node_modules
**/.turbo
**/.astro
**/dist
.git
.worktrees
.data
**/.env
**/.env.*
**/*.env
!**/.env.example
deploy/.env*
deploy/runtime
deploy/.operation.lock
deploy/.updater-state*
deploy/.last-backup
deploy/.restore-settle*
**/*.tgz
**/*.tar.gz
packages/backend/.convex
packages/backend/.env.local
apps/bridge-host/bin
apps/bridge-host/.data
