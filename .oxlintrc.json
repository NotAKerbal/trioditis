{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // `pnpm lint`: oxlint's correctness rules, type-aware ones included, plus Convex's rules
  // for the backend.
  "plugins": ["eslint", "typescript", "unicorn", "oxc"],
  "categories": { "correctness": "error" },
  "options": { "typeAware": true, "reportUnusedDisableDirectives": "error" },
  "ignorePatterns": ["**/_generated/**", "**/betterAuth/generatedSchema.ts", "**/dist/**"],
  "rules": {
    "eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none", "ignoreRestSiblings": true }
    ]
  },
  "overrides": [
    {
      "files": ["packages/backend/convex/**"],
      "jsPlugins": ["@convex-dev/eslint-plugin"],
      "rules": {
        "@convex-dev/no-old-registered-function-syntax": "error",
        "@convex-dev/require-args-validator": "error",
        "@convex-dev/no-duplicate-indexes": "error",
        "@convex-dev/no-schema-import-cycle": "error",
        "@convex-dev/no-top-of-hour-crons": "error"
      }
    }
  ]
}
